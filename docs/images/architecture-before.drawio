<mxfile><diagram name="기존 방식"><mxGraphModel dx="700" dy="720" grid="0" gridSize="10" guides="1" page="1" pageWidth="700" pageHeight="720" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="기존 방식 (XCUITest만)" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=20;fontFamily=Apple SD Gothic Neo;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="400" height="40" as="geometry"/></mxCell><mxCell id="app" value="&lt;b&gt;앱 레포&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Apple SD Gothic Neo;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="320" height="50" as="geometry"/></mxCell><mxCell id="id" value="&lt;b&gt;① 화면마다 accessibilityIdentifier 추가&lt;/b&gt;&lt;br&gt;앱 코드 수정 · 리뷰 · 브랜치 충돌" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Apple SD Gothic Neo;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="320" height="70" as="geometry"/></mxCell><mxCell id="tgt" value="&lt;b&gt;② 앱 안 UI 테스트 타깃&lt;/b&gt;&lt;br&gt;Swift로 테스트 작성" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Apple SD Gothic Neo;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="320" height="60" as="geometry"/></mxCell><mxCell id="build" value="&lt;b&gt;③ 고칠 때마다 컴파일&lt;/b&gt;&lt;br&gt;xcodebuild build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Apple SD Gothic Neo;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="320" height="60" as="geometry"/></mxCell><mxCell id="runx" value="&lt;b&gt;④ 실행할 때마다 테스트 실행기를 새로 띄움&lt;/b&gt;&lt;br&gt;xcodebuild test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Apple SD Gothic Neo;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="320" height="60" as="geometry"/>