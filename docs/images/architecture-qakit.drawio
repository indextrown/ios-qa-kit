idth="280" height="70" as="geometry"/></mxCell><mxCell id="yml" value="&lt;b&gt;scenarios/*.qa.yml&lt;/b&gt;&lt;br&gt;컴파일 없음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Apple SD Gothic Neo;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="280" height="60" as="geometry"/></mxCell><mxCell id="run" value="&lt;b&gt;qakit run&lt;/b&gt;&lt;br&gt;--reuse-app: 시작 화면이면 앱 재실행 생략" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Apple SD Gothic Neo;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="360" width="280" height="70" as="geometry"/></mxCell><mxCell id="people" value="&lt;b&gt;사람 · 정기 실행&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Apple SD Gothic Neo;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="520" width="280" height="50" as="geometry"/></mxCell><mxCell id="e0" value="① 앱이 바뀌면 자동 재빌드 · 설치" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;fontFamily=Apple SD Gothic Neo;" edge="1" parent="1" source="app" target="sim"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="주입" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;fontFamily=Apple SD Gothic Neo;dashed=1;" edge="1" parent="1" source="auto" target="sim"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="조작 · 화면 구조" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;fontFamily=Apple SD Gothic Neo;startArrow=block;startFill=1;" edge="1" parent="1" source="runner" target="sim"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="② qakit do &#x27;