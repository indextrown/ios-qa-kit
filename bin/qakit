#!/usr/bin/env python3
"""
qakit — AI가 XCUITest를 만들고 돌리기 쉽게 해 주는 CLI.

사람과 AI가 같은 명령을 쓴다. 출력은 짧고, 다음에 할 일을 알려 준다.

  qakit init <앱 프로젝트>     작업공간 생성
  qakit doctor                 환경 점검
  qakit build-app              대상 앱 빌드 + 시뮬레이터 설치 + 권한 허용
  qakit sync                   앱 변경 반영 (재빌드 + ID 재생성 + 테스트 코드 컴파일 확인)
  qakit gen-ids [--verify]     앱 소스에서 ID 상수 생성 (런타임 덤프와 비교)
  qakit dump-ui                현재 화면 구조를 텍스트로 저장
  qakit test [필터...]         UI 테스트 실행
  qakit summarize [xcresult]   실패 원인 요약
  qakit run <시나리오>          시나리오 파일(.qa.yml) 실행 (Swift·프로젝트 없이)
  qakit check [시나리오]        시나리오 형식·ID 정적 검사
  qakit save / restore         결과물 저장(qa.lock.json+보관소) / AI 없이 복구
  qakit history                실행 기록
  qakit readme                 QA 폴더 README.md의 QA 목록 갱신 (run·test·check·save 때 자동)
  qakit install-skill          AI 스킬과 qakit 명령 설치

작업공간은 현재 폴더에서 위로 올라가며 qakit.yml을 찾거나, -w로 지정한다.
Python 3.9 표준 라이브러리만 쓴다.
"""

# 코드는 lib/qakit/*.py에 구역별로 나뉘어 있다 (예전엔 이 파일 하나에 약 6,000줄).
# 이름 순서대로 이 파일의 이름 공간에 읽어 들인다 → 함수·전역 변수는 한 파일이던 때와 같다.
# 오류 위치는 lib/qakit/<파일>.py:<줄>로 나온다.
#
# 시작 캐시: 컴파일 결과를 import와 같은 .pyc(__pycache__)로 남겨 다음 실행에 다시 쓴다
# (명령마다 1만 줄을 컴파일하던 약 60ms가 없어진다). 원본의 수정 시각·크기가 바뀌면 다시 컴파일한다.
# 도구 폴더에 쓸 수 없거나 맥 앱 번들 안이면(쓰면 서명이 깨진다) .pyc를 사용자 캐시 폴더에 둔다
# — Python 표준 PYTHONPYCACHEPREFIX와 같은 방식이라 Tools/의 모듈·표준 라이브러리 것도 거기로 간다.
import os as _os
import sys as _sys
from importlib.machinery import SourceFileLoader as _Loader
from pathlib import Path as _Path

_kit = _os.path.dirname(_os.path.dirname(_os.path.realpath(__file__)))
if _sys.pycache_prefix is None and (".app/Contents/" in _kit + "/" or not _os.access(_kit, _os.W_OK)):
    _sys.pycache_prefix = _os.path.join(
        _os.path.expanduser("~/Library/Caches") if _sys.platform == "darwin"
        else _os.environ.get("XDG_CACHE_HOME") or _os.path.expanduser("~/.cache"), "qakit", "pycache")
for _part in sorted(_Path(_kit, "lib", "qakit").glob("[0-9]*.py")):
    exec(_Loader("qakit." + _part.stem, str(_part)).get_code("qakit." + _part.stem), globals())
