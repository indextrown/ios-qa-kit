# ─────────────────────────────── 출력 ───────────────────────────────

def info(msg):
    print(msg, flush=True)


def ok(msg):
    print(f"✅ {msg}", flush=True)


def warn(msg):
    print(f"⚠️  {msg}", flush=True)


def fail(msg, hint=None, code=1):
    print(f"❌ {msg}", file=sys.stderr, flush=True)
    if hint:
        print(f"   → {hint}", file=sys.stderr, flush=True)
    sys.exit(code)


# ─────────────────────────────── YAML (부분 집합) ───────────────────────────────
# qakit.yml에 필요한 만큼만: 들여쓰기 중첩 맵, 스칼라, [a, b] 인라인 리스트, 주석.

def parse_yaml(text):
    root = {}
    stack = [(-1, root)]
    for lineno, raw in enumerate(text.splitlines(), 1):
        line = re.sub(r"\s+#.*$", "", raw) if not raw.lstrip().startswith("#") else ""
        if not line.strip():
            continue
        indent = len(line) - len(line.lstrip(" "))
        m = re.match(r"^\s*([A-Za-z0-9_.-]+)\s*:\s*(.*)$", line)
        if not m:
            raise ValueError(f"qakit.yml {lineno}번째 줄을 읽을 수 없음: {raw}")
        key, value = m.group(1), m.group(2).strip()
        while stack and indent <= stack[-1][0]:
            stack.pop()
        parent = stack[-1][1]
        if value == "":
            child = {}
            parent[key] = child
            stack.append((indent, child))
        else:
            parent[key] = parse_scalar(value)
    return root


def parse_scalar(value):
    if value.startswith("[") and value.endswith("]"):
        inner = value[1:-1].strip()
        return [parse_scalar(v.strip()) for v in inner.split(",")] if inner else []
    if (value.startswith('"') and value.endswith('"')) or (value.startswith("'") and value.endswith("'")):
        return value[1:-1]
    if value in ("true", "yes"):
        return True
    if value in ("false", "no"):
        return False
    return value


# ─────────────────────────────── 작업공간 ───────────────────────────────

class Workspace:
    def __init__(self, root):
        self.root = Path(root).resolve()
        self.config_path = self.root / "qakit.yml"
        try:
            self.cfg = parse_yaml(self.config_path.read_text(encoding="utf-8"))
        except ValueError as e:
            fail(str(e))
        app = self.cfg.get("app") or {}
        self.name = self.cfg.get("name") or self.root.name
        self.project = expand(app.get("project", ""), self.root)
        self.scheme = app.get("scheme", "")
        self.configuration = app.get("configuration", "Debug")
        self.bundle_id = app.get("bundleId", "")
        self.simulator = str(self.cfg.get("simulator", "iPhone 17"))
        self.language = self.cfg.get("language")
        self.locale = self.cfg.get("locale")
        perms = self.cfg.get("permissions") or []
        self.permissions = perms if isinstance(perms, list) else [perms]
        self.secrets_path = expand(self.cfg.get("secrets", "./secrets.txt"), self.root)
        self.autoid = self.cfg.get("autoid", "inject")
        self.swiftui = str(self.cfg.get("swiftui", "auto"))  # auto | insert | off — SwiftUI 소스에 ID 삽입(QA 워크트리 빌드 중)
        self.sync_mode = self.cfg.get("sync", "auto")  # auto | warn | off
        wt = self.cfg.get("worktree") or {}
        wt = wt if isinstance(wt, dict) else {}
        self.worktree_base = str(wt.get("base", "develop"))     # QA 워크트리가 따라갈 브랜치
        self.worktree_update = str(wt.get("update", "auto"))    # auto | warn | off
        ids = self.cfg.get("ids") or {}
        srcs = ids.get("sources") if isinstance(ids, dict) else None
        self.id_sources = [expand(x, self.root) for x in (srcs if isinstance(srcs, list) else [srcs] if srcs else [])]
        self.app_override = False
        self.device = None   # --device로 고른 실기기 (None = 시뮬레이터)
        # 빌드 종류: debug(기본) = app.configuration / release = app.release.configuration (기본 Release)
        self.build = BUILD_MODE or "debug"
        self.state_name = "installed"
        if self.build == "release":
            rel = app.get("release") or {}
            rel = rel if isinstance(rel, dict) else {}
            self.configuration = str(rel.get("configuration", "Release"))
            self.bundle_id = rel.get("bundleId") or self._release_bundle_id()
            self.state_name = "installed-release"
        self.runner_dir = self.root / "Runner"
        self.build_dir = self.root / ".build"
        self.results_dir = self.root / "results"

    def _release_bundle_id(self):
        """release 빌드의 bundle ID: qakit.yml에 없으면 프로젝트에서 읽고 .qakit/release.json에 기억한다."""
        cache = self.root / ".qakit" / "release.json"
        key = f"{self.project}|{self.scheme}|{self.configuration}"
        try:
            data = json.loads(cache.read_text())
            if data.get("key") == key and data.get("bundleId"):
                return data["bundleId"]
        except (OSError, ValueError):
            pass
        bid = app_bundle_id(self.project, self.scheme, self.configuration) if self.project else None
        if not bid:
            fail(f"release 빌드({self.configuration})의 bundle ID를 찾지 못했습니다.",
                 "qakit.yml에 app.release.bundleId 또는 app.release.configuration을 적으세요")
        cache.parent.mkdir(exist_ok=True)
        cache.write_text(json.dumps({"key": key, "bundleId": bid}, ensure_ascii=False))
        return bid

    @property
    def app_dir(self):
        return self.project.parent if self.project else None

    @property
    def app_build_dir(self):
        # 앱 경로별로 빌드 폴더를 나눈다 (워크트리/브랜치 폴더를 오가도 서로 덮어쓰지 않게)
        suffix = "-device" if self.device else ""
        if not self.app_override:
            return self.build_dir / ("app" + suffix)
        return self.build_dir / ("app-" + slug(str(self.app_dir.name)) + suffix)

    @property
    def state_dir(self):
        return self.root / ".qakit"

    @property
    def ids_file(self):
        return self.runner_dir / "UITests" / "Generated" / "QAIDs.swift"

    @property
    def runner_project(self):
        return self.runner_dir / "QARunner.xcodeproj"

    @property
    def autoid_dylib(self):
        return KIT_DIR / ".build" / ("autoid-device" if self.device else "autoid") / "QAAutoID.dylib"

    @property
    def swiftui_manifest(self):
        """SwiftUI ID 삽입 중 원본을 보관하는 파일. 남아 있으면 복원이 안 된 것."""
        return self.state_dir / "swiftui-ids.json"

    def secrets(self):
        if not self.secrets_path.exists():
            return {}
        result = {}
        for raw in self.secrets_path.read_text(encoding="utf-8").splitlines():
            line = raw.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            value = re.sub(r"\s+#.*$", "", value).strip()
            result[key.strip()] = value
        return result


def expand(path, base):
    if not path:
        return None
    p = Path(os.path.expanduser(str(path)))
    return (p if p.is_absolute() else (base / p)).resolve()


SECRETS_OVERRIDE = None
APP_OVERRIDE = None
BUILD_MODE = None   # --build debug|release
DEVICE_ARG = None   # --device select|last|<이름>


def find_workspace(explicit):
    ws = _find_workspace(explicit)
    if SECRETS_OVERRIDE:
        ws.secrets_path = Path(SECRETS_OVERRIDE).expanduser().resolve()
    if APP_OVERRIDE:
        project = find_project(Path(APP_OVERRIDE).expanduser().resolve())
        if not project:
            fail(f"--app {APP_OVERRIDE}에서 .xcodeproj/.xcworkspace를 찾지 못했습니다.")
        if project.resolve() != (ws.project.resolve() if ws.project else None):
            ws.project = project.resolve()
            ws.app_override = True
            info(f"ℹ️  앱 경로 일시 지정: {ws.project}")
    if DEVICE_ARG:
        ws.device = choose_device(ws, DEVICE_ARG)
        if ws.device:
            ws.state_name += f"-device-{ws.device['udid']}"
    return ws


def _find_workspace(explicit):
    if explicit:
        root = Path(explicit).expanduser().resolve()
        if not (root / "qakit.yml").exists():
            fail(f"{root}에 qakit.yml이 없습니다.", "qakit init <앱 프로젝트>로 작업공간을 먼저 만드세요.")
        return Workspace(root)
    cur = Path.cwd().resolve()
    for d in [cur, *cur.parents]:
        if (d / "qakit.yml").exists():
            return Workspace(d)
    fail("qakit.yml을 찾지 못했습니다.", "작업공간 폴더에서 실행하거나 -w <작업공간>을 지정하세요.")


# ─────────────────────────────── 실행 유틸 ───────────────────────────────

def run(cmd, check=True, capture=True, cwd=None, env=None):
    result = subprocess.run(cmd, cwd=cwd, env=env, text=True, encoding="utf-8", errors="replace",
                            stdout=subprocess.PIPE if capture else None,
                            stderr=subprocess.STDOUT if capture else None)
    if check and result.returncode != 0:
        out = (result.stdout or "")[-3000:]
        fail(f"명령 실패 ({result.returncode}): {' '.join(map(str, cmd[:4]))} ...\n{out}")
    return result


def masker(secrets):
    values = sorted({v for v in secrets.values() if v and len(v) >= 3}, key=len, reverse=True)

    def mask(text):
        for v in values:
            text = text.replace(v, "•••")
        return text
    return mask


def timestamp():
    return datetime.datetime.now().strftime("%Y%m%d-%H%M%S")


# ─────────────────────────────── 시뮬레이터 ───────────────────────────────

def simulator_udid(name_or_udid):
    data = json.loads(run(["xcrun", "simctl", "list", "devices", "available", "-j"]).stdout)
    candidates = []
    for runtime, devices in data["devices"].items():
        if "iOS" not in runtime:
            continue
        for d in devices:
            if d["udid"] == name_or_udid:
                return d["udid"], d["state"]
            if d["name"] == name_or_udid:
                candidates.append((runtime, d))
    if not candidates:
        return None, None
    runtime, d = sorted(candidates, key=lambda c: c[0])[-1]  # 가장 최신 iOS
    return d["udid"], d["state"]


def ensure_booted(ws):
    udid, state = simulator_udid(ws.simulator)
    if not udid:
        fail(f"시뮬레이터 '{ws.simulator}'를 찾지 못했습니다.",
             "xcrun simctl list devices available 로 이름을 확인하고 qakit.yml의 simulator를 고치세요.")
    if state != "Booted":
        info(f"시뮬레이터 부팅 중: {ws.simulator}")
        run(["xcrun", "simctl", "boot", udid], check=False)
        run(["xcrun", "simctl", "bootstatus", udid, "-b"])
    return udid


@contextlib.contextmanager
def sim_lock(ws, what):
    """시뮬레이터 하나에 qakit 실행은 한 번에 하나만. 두 실행이 같은 앱을 동시에 조작하면 입력이 섞인다.
    다른 실행이 있으면 누가 돌리는지 알려 주고 끝날 때까지 기다린다."""
    udid = ws.device["udid"] if ws.device else ensure_booted(ws)
    lock_dir = Path.home() / ".qakit" / "locks"
    lock_dir.mkdir(parents=True, exist_ok=True)
    path = lock_dir / f"{udid}.lock"
    f = open(path, "a+")
    try:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            f.seek(0)
            holder = f.read().strip() or "다른 qakit 실행"
            warn(f"이 {'기기' if ws.device else '시뮬레이터'}에서 다른 실행이 진행 중입니다 → 끝날 때까지 기다립니다\n   ({holder})")
            fcntl.flock(f, fcntl.LOCK_EX)
            ok("앞선 실행이 끝났습니다. 시작합니다.")
        f.seek(0)
        f.truncate()
        f.write(f"pid {os.getpid()} · {what} · {ws.root} · {datetime.datetime.now():%H:%M:%S} 시작")
        f.flush()
        yield udid
    finally:
        fcntl.flock(f, fcntl.LOCK_UN)
        f.close()


def app_installed(udid, bundle_id):
    r = run(["xcrun", "simctl", "get_app_container", udid, bundle_id], check=False)
    return r.returncode == 0


# ─────────────────────────────── 실기기 (--device) ───────────────────────────────
# 같은 네트워크(또는 케이블)로 연결된 iPhone/iPad에서 시나리오를 돌린다.
# 시뮬레이터와 다른 점: 앱·실행기를 개발자 팀으로 서명, AutoID dylib을 앱 안(Frameworks/)에 넣고 다시 서명,
# devicectl로 설치. Mac 파일을 읽고 쓸 수 없어 시나리오는 내용째(base64) 넘기고 결과는 테스트 첨부로 받는다.

DEVICE_AUTOID_PATH = "@executable_path/Frameworks/QAAutoID.dylib"


def list_devices():
    """devicectl이 아는 iOS 기기 목록 (페어링된 것)."""
    out = Path(tempfile.mkstemp(suffix=".json")[1])
    try:
        run(["xcrun", "devicectl", "list", "devices", "--json-output", str(out)], check=False)
        data = json.loads(out.read_text() or "{}")
    except (OSError, ValueError):
        data = {}
    finally:
        out.unlink(missing_ok=True)
    devices = []
    for d in (data.get("result") or {}).get("devices", []):
        hw, dp, cp = d.get("hardwareProperties", {}), d.get("deviceProperties", {}), d.get("connectionProperties", {})
        if hw.get("platform") not in ("iOS", "iPadOS") or not hw.get("udid"):
            continue
        state = cp.get("tunnelState") or "unavailable"
        transport = cp.get("transportType")
        devices.append({
            "name": dp.get("name") or hw.get("marketingName") or d.get("identifier"),
            "id": d.get("identifier"), "udid": hw.get("udid"),
            "model": hw.get("marketingName") or "", "os": dp.get("osVersionNumber") or "",
            "state": state, "transport": transport,
            "developerMode": dp.get("developerModeStatus") == "enabled",
            "available": state != "unavailable",
        })
    return devices


def device_status_text(d):
    if not d["available"]:
        return "연결 안 됨"
    if d["state"] == "connected":
        return "케이블 연결됨" if d["transport"] == "wired" else "무선 연결됨"
    return "같은 네트워크 (실행할 때 연결)"


def _last_device_file(ws):
    return ws.state_dir / "device.json"


def pick_from_list(title, rows, start=0):
    """방향키로 고르는 목록. rows = [(글자, 선택 가능)]. 고른 번호 또는 None(취소)."""
    import termios
    import tty
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    idx = start if rows[start][1] else next((i for i, r in enumerate(rows) if r[1]), 0)
    out = sys.stdout

    def draw(first):
        if not first:
            out.write(f"\x1b[{len(rows) + 2}F")
        out.write(f"\x1b[J{title}  (↑↓ 이동 · Enter 선택 · Esc 취소)\r\n\r\n")
        for i, (text, enabled) in enumerate(rows):
            if i == idx:
                out.write(f"  \x1b[1;36m❯ {text}\x1b[0m\r\n")
            elif not enabled:
                out.write(f"    \x1b[2m{text}\x1b[0m\r\n")
            else:
                out.write(f"    {text}\r\n")
        out.flush()

    def move(step):
        nonlocal idx
        for _ in range(len(rows)):
            idx = (idx + step) % len(rows)
            if rows[idx][1]:
                return

    try:
        tty.setraw(fd)
        out.write("\x1b[?25l")
        draw(True)
        while True:
            ch = os.read(fd, 1)
            if ch in (b"\r", b"\n"):
                return idx
            if ch in (b"q", b"\x03"):
                return None
            if ch == b"\x1b":
                seq = os.read(fd, 2) if select_ready(fd) else b""
                if seq == b"[A":
                    move(-1)
                elif seq == b"[B":
                    move(1)
                elif not seq:
                    return None
            elif ch in (b"k",):
                move(-1)
            elif ch in (b"j",):
                move(1)
            elif ch.isdigit() and 1 <= int(ch) <= len(rows) and rows[int(ch) - 1][1]:
                idx = int(ch) - 1
            draw(False)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        out.write("\x1b[?25h")
        out.flush()


def text_width(text):
    """터미널에 보이는 폭 (한글 등 넓은 글자는 2칸)."""
    import unicodedata
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in str(text))


def pad(text, width):
    return str(text) + " " * max(1, width - text_width(text))


def select_ready(fd, timeout=0.05):
    import select
    return bool(select.select([fd], [], [], timeout)[0])


def choose_device(ws, arg):
    """--device 값 → 기기 dict, 또는 None(시뮬레이터). select: 방향키 목록 / last: 지난번 기기 / 이름·UDID."""
    devices = list_devices()
    last = {}
    try:
        last = json.loads(_last_device_file(ws).read_text())
    except (OSError, ValueError):
        pass
    arg = str(arg).strip()
    if arg in ("select", "list", "?"):
        if not (sys.stdin.isatty() and sys.stdout.isatty()):
            listing = "\n   ".join(f"{d['name']}  ({d['model']}, iOS {d['os']}, {device_status_text(d)})" for d in devices)
            fail("--device select는 터미널에서만 고를 수 있습니다.",
                 f'--device "<이름>"으로 지정하세요. 기기 목록:\n   {listing or "(페어링된 기기 없음)"}')
        devices.sort(key=lambda d: (not d["available"], d["udid"] != last.get("udid"), d["name"]))
        ready = [d for d in devices if d["available"]]
        sim = {"name": "시뮬레이터", "model": ws.simulator, "sim": True}
        order = ready + [sim] + [d for d in devices if not d["available"]]   # 연결 안 된 기기는 맨 아래
        name_w = max(text_width(d["name"]) for d in order) + 2
        model_w = max(text_width(d["model"]) for d in order) + 2
        rows = []
        for d in order:
            head = pad(d["name"], name_w) + pad(d["model"], model_w)
            if d.get("sim"):
                rows.append((head + "(qakit.yml의 simulator)", True))
                continue
            tag = "   ← 지난번" if d["udid"] == last.get("udid") else ""
            rows.append((head + pad(f"iOS {d['os']}", 13) + device_status_text(d) + tag, d["available"]))
        devices = order
        choice = pick_from_list("실행할 기기를 고르세요", rows)
        if choice is None:
            fail("취소했습니다.")
        if devices[choice].get("sim"):
            return None
        device = devices[choice]
    elif arg == "last":
        device = next((d for d in devices if d["udid"] == last.get("udid")), None)
        if not device:
            fail("지난번에 고른 기기가 없거나 지금 목록에 없습니다.", "--device select로 고르세요")
    else:
        key = arg.lower()
        matches = [d for d in devices if key in (d["udid"].lower(), (d["id"] or "").lower(), d["name"].lower())]
        matches = matches or [d for d in devices if key in d["name"].lower()]
        if len(matches) != 1:
            listing = "\n   ".join(d["name"] for d in devices) or "(페어링된 기기 없음)"
            fail(f"기기 '{arg}'를 " + ("찾지 못했습니다." if not matches else "하나로 정하지 못했습니다."),
                 f"이름을 정확히 쓰거나 --device select로 고르세요. 기기 목록:\n   {listing}")
        device = matches[0]
    if not device["available"]:
        fail(f"{device['name']}이(가) 연결돼 있지 않습니다.",
             "기기 잠금을 풀고 Mac과 같은 Wi-Fi에 있는지 확인하세요 (처음엔 케이블로 한 번 연결해 Xcode에서 페어링)")
    if not device["developerMode"]:
        fail(f"{device['name']}의 개발자 모드가 꺼져 있습니다.", "기기에서 설정 › 개인정보 보호 및 보안 › 개발자 모드를 켜세요")
    ws.state_dir.mkdir(exist_ok=True)
    _last_device_file(ws).write_text(json.dumps({"udid": device["udid"], "name": device["name"]}, ensure_ascii=False))
    info(f"📱 실기기: {device['name']} ({device['model']}, iOS {device['os']}, {device_status_text(device)})")
    return device


def device_team(ws):
    """서명할 개발자 팀: qakit.yml device.team → 앱 빌드 설정의 DEVELOPMENT_TEAM (기억해 둔다)."""
    cfg = ws.cfg.get("device") or {}
    if isinstance(cfg, dict) and cfg.get("team"):
        return str(cfg["team"])
    cache = ws.state_dir / "device-team.json"
    key = f"{ws.project}|{ws.scheme}|{ws.configuration}"
    try:
        data = json.loads(cache.read_text())
        if data.get("key") == key and data.get("team"):
            return data["team"]
    except (OSError, ValueError):
        pass
    r = run(["xcodebuild", "-showBuildSettings", *project_flag(ws.project), "-scheme", ws.scheme,
             "-configuration", ws.configuration, "-destination", "generic/platform=iOS"], check=False)
    team = next((l.split("=", 1)[1].strip() for l in (r.stdout or "").splitlines()
                 if l.strip().startswith("DEVELOPMENT_TEAM =")), "")
    if not team:
        fail("실기기 서명에 쓸 개발자 팀을 찾지 못했습니다.", "qakit.yml에 device: { team: <팀 ID> }를 적으세요")
    ws.state_dir.mkdir(exist_ok=True)
    cache.write_text(json.dumps({"key": key, "team": team}))
    return team


def embed_autoid(app_path, dylib):
    """AutoID dylib을 앱의 Frameworks/에 넣고 앱과 같은 인증서·권한으로 다시 서명한다."""
    r = run(["codesign", "-dvvv", str(app_path)], check=False)
    identity = next((l.split("=", 1)[1] for l in (r.stdout or "").splitlines() if l.startswith("Authority=")), None)
    if not identity:
        fail(f"{app_path.name}의 서명 인증서를 읽지 못했습니다.", "Xcode에서 이 앱을 기기로 한 번 실행해 서명을 확인하세요")
    ent = Path(tempfile.mkstemp(suffix=".plist")[1])
    try:
        # stdout만 (stderr의 "Executable=…" 줄이 섞이면 plist가 깨진다)
        ent.write_bytes(subprocess.run(["codesign", "-d", "--entitlements", "-", "--xml", str(app_path)],
                                       stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout or b"")
        fw = app_path / "Frameworks"
        fw.mkdir(exist_ok=True)
        shutil.copy2(dylib, fw / "QAAutoID.dylib")
        run(["codesign", "--force", "--sign", identity, str(fw / "QAAutoID.dylib")])
        sign = ["codesign", "--force", "--sign", identity, "--generate-entitlement-der"]
        if ent.stat().st_size > 0:
            sign += ["--entitlements", str(ent)]
        run(sign + [str(app_path)])
    finally:
        ent.unlink(missing_ok=True)


def device_install(ws, app_path):
    run(["xcrun", "devicectl", "device", "install", "app", "--device", ws.device["id"], str(app_path)])


def device_app_installed(ws):
    r = run(["xcrun", "devicectl", "device", "info", "apps", "--device", ws.device["id"],
             "--bundle-id", ws.bundle_id], check=False)
    return r.returncode == 0 and ws.bundle_id in (r.stdout or "")


def device_app_pid(ws):
    """기기에서 실행 중인 대상 앱의 PID (앱 설치 경로로 찾는다 — 이름이 같은 다른 앱과 구분)."""
    def devicectl_json(*cmd):
        out = Path(tempfile.mkstemp(suffix=".json")[1])
        try:
            run(["xcrun", "devicectl", "device", "info", *cmd, "--device", ws.device["id"],
                 "--json-output", str(out)], check=False)
            return json.loads(out.read_text() or "{}").get("result") or {}
        except (OSError, ValueError):
            return {}
        finally:
            out.unlink(missing_ok=True)
    apps = devicectl_json("apps", "--bundle-id", ws.bundle_id).get("apps") or []
    url = (apps[0].get("url") if apps else "") or ""
    prefix = url.replace("file://", "").rstrip("/").replace("/private/var/", "/var/")
    if not prefix:
        return None
    for p in devicectl_json("processes").get("runningProcesses") or []:
        exe = (p.get("executable") or "").replace("file://", "").replace("/private/var/", "/var/")
        if exe.startswith(prefix + "/"):
            return p.get("processIdentifier")
    return None


def ensure_device_runner(team):
    """시나리오 실행기를 실기기용으로 서명해서 빌드한다 (도구·팀이 바뀌었을 때만)."""
    build = KIT_DIR / ".build" / f"scenario-runner-device-{team}"
    h = hashlib.sha1(team.encode())
    for base in (KIT_DIR / "Sources" / "QAKit", KIT_DIR / "ScenarioRunner"):
        for f in sorted(base.rglob("*")):
            if f.is_file() and ".xcodeproj" not in str(f):
                h.update(str(f.relative_to(KIT_DIR)).encode())
                h.update(f.read_bytes())
    h.update(run(["xcodebuild", "-version"], check=False).stdout.encode())
    stamp = build / ".stamp"
    found = list((build / "Build" / "Products").glob("*iphoneos*.xctestrun"))
    if found and stamp.exists() and stamp.read_text() == h.hexdigest():
        return found[0]
    info("시나리오 실행기 빌드 중 (실기기용, 도구가 바뀌었을 때 한 번)...")
    run(["xcodegen", "generate", "--quiet", "--spec", str(KIT_DIR / "ScenarioRunner" / "project.yml"),
         "--project", str(KIT_DIR / "ScenarioRunner")])
    r = run(["xcodebuild", "build-for-testing", "-project", str(SCENARIO_PROJECT), "-scheme", "ScenarioTests",
             "-destination", "generic/platform=iOS", "-derivedDataPath", str(build),
             "CODE_SIGNING_ALLOWED=YES", "CODE_SIGN_STYLE=Automatic", f"DEVELOPMENT_TEAM={team}",
             "-allowProvisioningUpdates"], check=False)
    if r.returncode != 0:
        errors = [l for l in (r.stdout or "").splitlines() if "error:" in l]
        fail("시나리오 실행기 빌드 실패 (실기기)", "\n   ".join(dict.fromkeys(errors[:10])))
    stamp.write_text(h.hexdigest())
    return list((build / "Build" / "Products").glob("*iphoneos*.xctestrun"))[0]


def extract_device_files(ws, xcresult, run_dir):
    """실기기 실행기가 첨부로 남긴 파일(qakit-file:<경로>)을 결과 폴더로 꺼낸다 (덤프 등)."""
    dest = Path(tempfile.mkdtemp())
    try:
        r = run(["xcrun", "xcresulttool", "export", "attachments", "--path", str(xcresult),
                 "--output-path", str(dest)], check=False)
        manifest = dest / "manifest.json"
        if r.returncode != 0 or not manifest.exists():
            return
        mask = masker(ws.secrets())
        for entry in json.loads(manifest.read_text()):
            for a in entry.get("attachments", []):
                name = a.get("suggestedHumanReadableName", "")
                if not name.startswith("qakit-file:"):
                    continue
                rel = re.sub(r"_\d+_[0-9A-F-]{36}(\.\w+)?$", "", name[len("qakit-file:"):])   # xcresult가 붙인 꼬리 제거
                rel = rel if rel.endswith(".txt") else rel + ".txt"
                if ".." in Path(rel).parts:
                    continue
                for target in (ws.results_dir / rel, run_dir / rel):
                    target.parent.mkdir(parents=True, exist_ok=True)
                    target.write_text(mask((dest / a["exportedFileName"]).read_text(encoding="utf-8", errors="replace")),
                                      encoding="utf-8")
    finally:
        shutil.rmtree(dest, ignore_errors=True)




# ─────────────────────────────── 빌드 ───────────────────────────────

def project_flag(project):
    return ["-workspace" if str(project).endswith(".xcworkspace") else "-project", str(project)]


def ensure_autoid(ws):
    if ws.autoid != "inject":
        return
    src = KIT_DIR / "AutoID"
    dylib = ws.autoid_dylib
    newest_src = max(p.stat().st_mtime for p in src.iterdir())
    if not dylib.exists() or dylib.stat().st_mtime < newest_src:
        info("AutoID dylib 빌드 중..." + (" (실기기용)" if ws.device else ""))
        run([str(KIT_DIR / "scripts" / "build-autoid.sh"), str(dylib.parent), "device" if ws.device else "simulator"])


SWIFTUI_IDS_DIR = KIT_DIR / "Tools" / "swiftui-ids"
SWIFTUI_IDS_BIN = SWIFTUI_IDS_DIR / ".build" / "release" / "swiftui-ids"


def ensure_swiftui_ids():
    """swiftui-ids 도구를 소스가 바뀌었을 때만 빌드한다 (처음엔 SwiftSyntax 컴파일로 몇 분).
    수정 시각이 아니라 소스 해시로 판단한다 (git checkout·복사로 시각이 흔들려도 다시 빌드하지 않게)."""
    h = hashlib.sha1()
    for f in sorted([SWIFTUI_IDS_DIR / "Package.swift"] + list((SWIFTUI_IDS_DIR / "Sources").rglob("*.swift"))):
        h.update(str(f.relative_to(SWIFTUI_IDS_DIR)).encode())
        h.update(f.read_bytes())
    digest = h.hexdigest()
    stamp = SWIFTUI_IDS_BIN.with_suffix(".stamp")
    if not SWIFTUI_IDS_BIN.exists() or not stamp.exists() or stamp.read_text().strip() != digest:
        info("swiftui-ids 도구 빌드 중... (처음엔 SwiftSyntax 컴파일로 몇 분 걸립니다)")
        r = run(["swift", "build", "-c", "release", "--package-path", str(SWIFTUI_IDS_DIR)], check=False)
        if r.returncode != 0 or not SWIFTUI_IDS_BIN.exists():
            fail("swiftui-ids 빌드 실패", (r.stdout or "")[-800:])
        stamp.write_text(digest)
    return SWIFTUI_IDS_BIN


def swiftui_sources(ws):
    return [str(p) for p in (ws.id_sources or [ws.app_dir])]


def swiftui_enabled(ws):
    """swiftui: off → 안 함 / insert → 함 / auto → 앱 소스에 `import SwiftUI`가 있으면 함."""
    if ws.swiftui == "off":
        return False
    if ws.swiftui == "insert":
        return True
    for f in gen_ids.iter_swift_files(swiftui_sources(ws)):
        try:
            if ws.root in f.parents:
                continue
            with open(f, encoding="utf-8", errors="replace") as fh:
                if "import SwiftUI" in fh.read(4000):
                    return True
        except OSError:
            pass
    return False


def is_qa_worktree(app_dir):
    """앱 폴더가 git 연결 워크트리(qakit init --worktree)인가. 개발 폴더에는 소스를 고치지 않는다."""
    git_dir = git(app_dir, "rev-parse", "--git-dir")
    common = git(app_dir, "rev-parse", "--git-common-dir")
    return bool(git_dir and common and Path(app_dir, git_dir).resolve() != Path(app_dir, common).resolve())


def swiftui_insert(ws):
    """QA 워크트리의 SwiftUI 소스에 ID를 끼워 넣는다. 빌드가 끝나면 반드시 swiftui_restore. 반환: manifest 경로 또는 None"""
    if not swiftui_enabled(ws):
        return None
    if not is_qa_worktree(ws.app_dir):
        # 개발 폴더의 소스는 고치지 않는다. auto면 건너뛰고(UIKit 앱에 SwiftUI 파일이 조금 섞인 경우), insert면 실패.
        if ws.swiftui == "insert":
            fail("SwiftUI ID 삽입은 QA 워크트리에서만 합니다 (개발 폴더의 소스는 고치지 않습니다).",
                 "qakit init <앱> --worktree 로 만든 작업공간을 쓰거나, qakit.yml에 swiftui: off")
        warn("SwiftUI 소스가 있지만 앱 폴더가 QA 워크트리가 아니라 ID를 삽입하지 않습니다 (qakit init --worktree)")
        return None
    tool = ensure_swiftui_ids()
    manifest = ws.swiftui_manifest
    if manifest.exists():
        fail("이전 SwiftUI ID 삽입이 복원되지 않았습니다.", "qakit swiftui-ids --restore")
    status = git(ws.app_dir, "status", "--porcelain", "--", *app_pathspec(ws)) or ""
    dirty = [l[3:] for l in status.splitlines() if l[:2].strip() and l[:2] != "??" and l.endswith(".swift")]
    if dirty:
        fail("워크트리의 Swift 소스에 커밋되지 않은 변경이 있어 ID를 삽입하지 않습니다: " + ", ".join(dirty[:5]),
             "워크트리는 개발 브랜치와 같아야 합니다. git -C <워크트리> status 로 확인")
    manifest.parent.mkdir(parents=True, exist_ok=True)
    r = run([str(tool), "insert", *swiftui_sources(ws), "--exclude", ws.root.name, "--manifest", str(manifest)], check=False)
    if r.returncode != 0:
        fail("SwiftUI ID 삽입 실패", (r.stdout or "")[-800:])
    info("   SwiftUI ID: " + (r.stdout or "").strip().splitlines()[-1])
    return manifest


def swiftui_restore(ws, manifest):
    if not manifest or not manifest.exists():
        return
    r = run([str(ensure_swiftui_ids()), "restore", "--manifest", str(manifest)], check=False)
    if r.returncode != 0 or manifest.exists():
        fail("SwiftUI ID 복원 실패 — 워크트리 소스가 바뀐 채 남아 있습니다.",
             f"qakit swiftui-ids --restore  (manifest: {manifest})")


def swiftui_list(ws):
    """swiftui-ids list --json → [{id, kind, view, file, line, overridable}]"""
    if not swiftui_enabled(ws):
        return []
    r = run([str(ensure_swiftui_ids()), "list", *swiftui_sources(ws), "--exclude", ws.root.name, "--json"], check=False)
    if r.returncode != 0:
        fail("swiftui-ids list 실패", (r.stdout or "")[-800:])
    text = r.stdout or ""
    return json.loads(text[text.index("["):text.rindex("]") + 1]) if "[" in text else []


RUNNER_MANAGED = ["Runner/project.yml", "Runner/Host/HostApp.swift", "Runner/UITests/QAKit/QAKitDumpTests.swift"]


def refresh_runner_template(ws):
    """템플릿이 관리하는 Runner 파일을 이 PC의 도구 경로로 다시 쓴다 (커밋해도 PC마다 경로가 달라 깨지지 않게)."""
    values = {"KIT_DIR": str(KIT_DIR), "NAME": ws.name}
    for rel in RUNNER_MANAGED:
        src = TEMPLATE_DIR / rel
        text = src.read_text(encoding="utf-8")
        for k, v in values.items():
            text = text.replace("{{" + k + "}}", v)
        dst = ws.root / rel
        if not dst.exists() or dst.read_text(encoding="utf-8") != text:
            dst.parent.mkdir(parents=True, exist_ok=True)
            dst.write_text(text, encoding="utf-8")


def has_swift_runner(ws):
    return (ws.runner_dir / "UITests").exists()


def ensure_runner(ws):
    if not has_swift_runner(ws):
        fail("이 작업공간에는 Swift 테스트(Runner/UITests)가 없습니다.", "시나리오 파일은 qakit run <시나리오>로 실행하세요.")
    refresh_runner_template(ws)
    spec = ws.runner_dir / "project.yml"
    proj = ws.runner_project / "project.pbxproj"
    sources = [spec] + list((ws.runner_dir / "UITests").rglob("*.swift"))
    if not proj.exists() or proj.stat().st_mtime < max(p.stat().st_mtime for p in sources):
        if not shutil.which("xcodegen"):
            fail("xcodegen이 없습니다.", "brew install xcodegen")
        run(["xcodegen", "generate", "--quiet"], cwd=ws.runner_dir)


def build_runner(ws, udid, log_path):
    ensure_runner(ws)
    cmd = ["xcodebuild", "build-for-testing", "-project", str(ws.runner_project),
           "-scheme", RUNNER_SCHEME, "-destination", f"id={udid}",
           "-derivedDataPath", str(ws.build_dir / "runner")]
    r = run(cmd, check=False)
    log_path.write_text(r.stdout or "", encoding="utf-8")
    if r.returncode != 0:
        errors = [l for l in (r.stdout or "").splitlines() if "error:" in l]
        fail("테스트 코드 빌드 실패", "\n   ".join(dict.fromkeys(errors[:15])) or f"로그: {log_path}")


# ─────────────────────────────── 테스트 실행 공통 ───────────────────────────────

def test_env(ws, extra=None):
    env = os.environ.copy()

    def put(key, value):
        if value is not None:
            env[f"TEST_RUNNER_{key}"] = str(value)
    put("QA_BUNDLE_ID", ws.bundle_id)
    put("QA_AUTOID_DYLIB", (DEVICE_AUTOID_PATH if ws.device else ws.autoid_dylib) if ws.autoid == "inject" else None)
    put("QA_DEVICE", "1" if ws.device else None)
    put("QA_LANGUAGE", ws.language)
    put("QA_LOCALE", ws.locale)
    put("QA_RESULTS_DIR", ws.results_dir)
    put("QA_SECRETS_FILE", ws.secrets_path)
    for k, v in ws.secrets().items():
        put(f"QA_SECRET_{k}", v)
    for k, v in (extra or {}).items():
        put(f"QA_ARG_{k}", v)
    return env


def new_run_dir(ws, label, name=None):
    """실행 한 번의 결과 폴더: results/<날짜>/<시각>-<종류>[-<이름>]/"""
    now = datetime.datetime.now()
    folder = now.strftime("%H%M%S") + f"-{label}" + (f"-{slug(name)}" if name else "")
    d = ws.results_dir / now.strftime("%Y-%m-%d") / folder
    d.mkdir(parents=True, exist_ok=True)
    return d


def _relink(link, target):
    if link.is_symlink() or link.exists():
        link.unlink()
    link.symlink_to(os.path.relpath(target, link.parent))


def run_tests(ws, only, extra_env=None, label="test", quiet=False):
    """xcodebuild test 실행. (성공 여부, xcresult 경로, 마스킹된 출력)"""
    ws.results_dir.mkdir(exist_ok=True)
    ensure_autoid(ws)
    udid = ensure_booted(ws)
    if not app_installed(udid, ws.bundle_id):
        fail(f"시뮬레이터에 {ws.bundle_id}가 설치되어 있지 않습니다.", "qakit build-app")

    ts = timestamp()
    rd = new_run_dir(ws, label, "-".join(o.split("/")[0] for o in only[:2]) if only else None)
    build_runner(ws, udid, rd / "build.log")

    xcresult = rd / "result.xcresult"
    cmd = ["xcodebuild", "test-without-building", "-project", str(ws.runner_project),
           "-scheme", RUNNER_SCHEME, "-destination", f"id={udid}",
           "-derivedDataPath", str(ws.build_dir / "runner"),
           "-resultBundlePath", str(xcresult)]
    for o in only:
        cmd += ["-only-testing", o if o.startswith("UITests/") else f"UITests/{o}"]
    if not only:
        cmd += ["-skip-testing", "UITests/QAKitDumpTests"]  # 전체 실행에서 덤프용 테스트 제외

    return execute_xctest(ws, cmd, extra_env, label, ts, xcresult, quiet)


def execute_xctest(ws, cmd, extra_env, label, ts, xcresult, quiet, history_name=None, on_line=None):
    """xcodebuild 테스트 실행 공통: 출력 마스킹·필터, 로그, latest 링크, 실행 기록."""
    mask = masker(ws.secrets())
    log_path = xcresult.parent / "output.log"
    proc = subprocess.Popen(cmd, env=test_env(ws, extra_env), text=True, encoding="utf-8", errors="replace",
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    shown = re.compile(r"Test Case .* (passed|failed|started)|error:|\[qakit-|Executed \d+ test")
    lines = []
    with open(log_path, "w", encoding="utf-8") as log:
        for line in proc.stdout:
            line = mask(line)
            log.write(line)
            lines.append(line)
            if on_line:
                on_line(line)
            if not quiet and shown.search(line):
                print("  " + simplify_line(line.rstrip()), flush=True)
    proc.wait()

    _relink(ws.results_dir / "latest", xcresult.parent)       # 마지막 실행 폴더
    latest = ws.results_dir / "latest.xcresult"
    if latest.is_symlink() or latest.exists():
        latest.unlink()
    if xcresult.exists():
        _relink(latest, xcresult)
        if label != "dump":
            record_history(ws, xcresult, label, history_name)
    return proc.returncode == 0, xcresult, "".join(lines)


def record_history(ws, xcresult, kind, scenario=None):
    """실행 기록 한 줄씩 (history.jsonl): 언제, 어느 앱 상태에서, 무엇이 통과/실패했는지."""
    try:
        tree = json.loads(run(["xcrun", "xcresulttool", "get", "test-results", "tests",
                               "--path", str(xcresult)], check=False).stdout or "{}")
    except json.JSONDecodeError:
        return
    cases = []

    def walk(node):
        if node.get("nodeType") == "Test Case":
            cases.append(node)
        for c in node.get("children", []):
            walk(c)
    for n in tree.get("testNodes", []):
        walk(n)
    state = app_state(ws)
    with open(ws.root / "history.jsonl", "a", encoding="utf-8") as f:
        for c in cases:
            f.write(json.dumps({
                "at": datetime.datetime.now().isoformat(timespec="seconds"),
                "kind": kind,
                "test": scenario or c.get("nodeIdentifier", c.get("name")),
                "result": c.get("result"),
                "seconds": round(c.get("durationInSeconds", 0), 1),
                "app": {k: state.get(k) for k in ("branch", "commit", "dirtyFiles") if k in state},
                "kit": kit_version(),
            }, ensure_ascii=False) + "\n")


def update_readme(ws, quiet=True):
    """QA 폴더 README.md의 자동 목록(시나리오·공통 단계·Swift 테스트·마지막 실행)을 갱신."""
    try:
        raw = (ws.cfg.get("app") or {}).get("project", "")   # 커밋해도 PC마다 맞도록 설정 값 그대로 (상대 경로)
        changed = qa_readme.write(ws.root, ws.name, f"테스트 대상 앱: `{raw}`")
    except Exception as e:  # README 때문에 본 작업이 실패하지 않게
        warn(f"README 갱신 실패: {e}")
        return
    if changed and not quiet:
        ok(f"README 갱신: {ws.root / 'README.md'}")


def cmd_readme(args):
    ws = find_workspace(args.workspace)
    update_readme(ws, quiet=False)
    ok(f"{ws.root / 'README.md'}")


def kit_version():
    v = (KIT_DIR / "VERSION").read_text().strip() if (KIT_DIR / "VERSION").exists() else "dev"
    c = git(KIT_DIR, "rev-parse", "--short", "HEAD")
    return f"{v}+{c}" if c else v


def simplify_line(line):
    line = re.sub(r"^.*Test Case '-\[UITests\.(\S+) (\S+)\]' ", r"\1/\2 ", line)
    line = line.replace(" started.", " …").replace(" passed ", " ✅ ").replace(" failed ", " ❌ ")
    return line


# ─────────────────────────────── 명령: init ───────────────────────────────

def cmd_init(args):
    target = Path(args.project).expanduser().resolve()
    project = find_project(target)
    if not project:
        fail(f"{target}에서 .xcworkspace / .xcodeproj를 찾지 못했습니다.")

    name = args.name or slug(project.parent.name)
    if args.worktree:
        project = make_qa_worktree(project, args)
        args.in_project = True
        args.git_exclude = True
    if args.in_project:
        root = project.parent / "QA"
    elif args.dir:
        root = Path(args.dir).expanduser().resolve()
    else:
        root = project.parent.parent / "qa-workspaces" / name
    if (root / "qakit.yml").exists() and not args.force:
        fail(f"이미 작업공간이 있습니다: {root}", "덮어쓰려면 --force")

    info(f"프로젝트 분석 중: {project}")
    listing = json.loads(run(["xcodebuild", "-list", "-json", *project_flag(project)]).stdout)
    schemes = (listing.get("project") or listing.get("workspace") or {}).get("schemes", [])
    if not schemes:
        fail("공유된 scheme이 없습니다.", "Xcode에서 scheme을 Shared로 설정하세요.")
    scheme, configuration, bundle_id = (args.scheme, None, None)
    if scheme:
        configuration = scheme_configuration(project, scheme) or "Debug"
        bundle_id = app_bundle_id(project, scheme, configuration)
    else:
        # 앱(.app)을 빌드하는 scheme만 후보로. 패키지 의존성 scheme(예: SDK 이름)은 앱을 만들지 않는다.
        for candidate in rank_schemes(schemes, project):
            conf = scheme_configuration(project, candidate) or "Debug"
            bid = app_bundle_id(project, candidate, conf)
            if bid:
                scheme, configuration, bundle_id = candidate, conf, bid
                break
        if not scheme:
            scheme, configuration = schemes[0], "Debug"
            warn("앱을 빌드하는 scheme을 찾지 못했습니다. qakit.yml의 scheme/bundleId를 직접 입력하세요.")
    info(f"  scheme: {scheme} (후보: {', '.join(schemes)})")
    info(f"  configuration: {configuration}")
    info(f"  bundleId: {bundle_id or '(찾지 못함 — qakit.yml에 직접 입력)'}")

    root.mkdir(parents=True, exist_ok=True)
    values = {
        "NAME": name,
        "PROJECT": (os.path.relpath(project, root) if args.in_project
                    else str(project).replace(str(Path.home()), "~")),
        "SCHEME": scheme,
        "CONFIGURATION": configuration,
        "BUNDLE_ID": bundle_id or "TODO.bundle.id",
        "SIMULATOR": args.simulator or default_simulator(),
        "KIT_DIR": str(KIT_DIR),
        "WORKTREE_BASE": getattr(args, "base", None) or "develop",
    }
    copy_template(TEMPLATE_DIR, root, values, force=args.force)
    (root / "results").mkdir(exist_ok=True)
    if args.in_project and args.git_exclude:
        add_git_exclude(project.parent, root)
    update_readme(Workspace(root))
    ok(f"작업공간 생성: {root}")
    info("다음 할 일:")
    info(f"  1. {root}/qakit.yml 확인 (permissions, language)")
    info(f"  2. secrets.example.txt를 참고해 secrets.txt 작성 (로그인이 필요한 앱이면)")
    info(f"  3. cd {root} && qakit doctor && qakit build-app && qakit dump-ui")


def make_qa_worktree(project, args):
    """앱 레포에 QA 전용 워크트리를 만든다 (원래 개발 폴더와 섞이지 않게). 이미 있으면 그대로 쓴다."""
    repo = project.parent
    if git(repo, "rev-parse", "--git-dir") is None:
        fail(f"{repo}는 git 레포가 아닙니다.", "--worktree 없이 --in-project 또는 기본 작업공간을 쓰세요")
    top = Path(git(repo, "rev-parse", "--show-toplevel"))
    wt = Path(args.worktree_dir).expanduser().resolve() if args.worktree_dir else top.parent / f"{top.name}-qa"
    branch = args.branch or "qa/workspace"
    listing = git(repo, "worktree", "list", "--porcelain") or ""
    if f"worktree {wt}" in listing:
        ok(f"기존 QA 워크트리 사용: {wt}")
    else:
        if wt.exists():
            fail(f"{wt}가 이미 있지만 이 레포의 워크트리가 아닙니다.", "--worktree-dir로 다른 위치를 지정하세요")
        exists = git(repo, "rev-parse", "--verify", "--quiet", branch) is not None
        if exists:
            cmd = ["git", "-C", str(repo), "worktree", "add", str(wt), branch]
        else:
            base = args.base or ("develop" if git(repo, "rev-parse", "--verify", "--quiet", "develop") else "HEAD")
            cmd = ["git", "-C", str(repo), "worktree", "add", "-b", branch, str(wt), base]
        r = run(cmd, check=False)
        if r.returncode != 0:
            fail("워크트리 생성 실패", r.stdout[-500:])
        ok(f"QA 워크트리 생성: {wt} (브랜치 {branch}" + ("" if exists else f", {args.base or 'develop'}에서") + ")")
    copy_local_files(top, wt)
    return wt / project.relative_to(top)


LOCAL_SKIP = re.compile(r"(^|/)(xcuserdata|\.build|build|DerivedData|Derived|\.claude|\.codex|\.githooks|\.tuist|\.obsidian|QA|Pods|node_modules|\.swiftpm|SourcePackages|[^/]+\.xcodeproj|[^/]+\.xcworkspace)(/|$)|\.DS_Store$")


def copy_local_files(src_repo, wt, max_bytes=1_000_000):
    """git에 없는 로컬 설정 파일(키가 든 xcconfig, GoogleService-Info.plist 등)을 원래 폴더에서 워크트리로 복사.
    워크트리는 git에 있는 파일만 가져오므로 이게 없으면 빌드가 실패한다. 내용은 출력하지 않는다."""
    out = git(src_repo, "ls-files", "--others", "--ignored", "--exclude-standard") or ""
    copied = []
    for rel in out.splitlines():
        if LOCAL_SKIP.search(rel):
            continue
        src, dst = Path(src_repo) / rel, Path(wt) / rel
        if not src.is_file() or src.stat().st_size > max_bytes or dst.exists():
            continue
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, dst)
        copied.append(rel)
    if copied:
        ok(f"git에 없는 로컬 설정 파일 {len(copied)}개를 원래 폴더에서 복사: " + ", ".join(copied[:10]))


def add_git_exclude(repo_dir, path):
    """레포의 .gitignore를 건드리지 않고 이 PC에서만 무시 (.git/info/exclude)."""
    # 워크트리에서는 --git-dir이 .git/worktrees/<이름>을 가리키지만 git은 공통 디렉터리의 info/exclude만 읽는다
    git_dir = git(repo_dir, "rev-parse", "--git-common-dir")
    if not git_dir:
        return
    exclude = (Path(repo_dir) / git_dir).resolve() / "info" / "exclude"
    rel = "/" + os.path.relpath(path, repo_dir).rstrip("/") + "/"
    exclude.parent.mkdir(parents=True, exist_ok=True)
    current = exclude.read_text() if exclude.exists() else ""
    if rel not in current.splitlines():
        exclude.write_text(current + ("" if current.endswith("\n") or not current else "\n") + rel + "\n")
        ok(f"{rel}를 이 PC의 git 무시 목록(.git/info/exclude)에 추가")


def find_project(path):
    if path.suffix in (".xcworkspace", ".xcodeproj"):
        return path
    if not path.is_dir():
        return None
    ws = [p for p in path.glob("*.xcworkspace")]
    if ws:
        return ws[0]
    pj = [p for p in path.glob("*.xcodeproj")]
    return pj[0] if pj else None


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")


def rank_schemes(schemes, project):
    """앱 scheme일 가능성 순: 개발용 키워드 > 프로젝트 이름과 같음 > 프로젝트에 공유된 scheme > 나머지."""
    shared = {p.stem for p in project.parent.glob("*.xcodeproj/xcshareddata/xcschemes/*.xcscheme")}
    name = project.stem.lower()

    def score(s):
        low = s.lower()
        if any(k in low for k in ("develop", "dev", "debug", "staging")):
            return 0
        if low == name:
            return 1
        if s in shared:
            return 2
        return 3
    return sorted(schemes, key=lambda s: (score(s), schemes.index(s)))


def scheme_configuration(project, scheme):
    container = project if project.suffix == ".xcodeproj" else None
    candidates = []
    if container:
        candidates.append(container / "xcshareddata" / "xcschemes" / f"{scheme}.xcscheme")
    candidates += list(project.parent.glob(f"*.xcodeproj/xcshareddata/xcschemes/{scheme}.xcscheme"))
    for c in candidates:
        if c.exists():
            node = ET.parse(c).getroot().find("LaunchAction")
            if node is not None and node.get("buildConfiguration"):
                return node.get("buildConfiguration")
    return None


def app_bundle_id(project, scheme, configuration):
    r = run(["xcodebuild", "-showBuildSettings", "-json", *project_flag(project), "-scheme", scheme,
             "-configuration", configuration, "-sdk", "iphonesimulator"], check=False)
    # 경고 문구가 섞여 나오므로(예: "Designed for [iPad,iPhone]") 줄 맨 앞의 '['부터 JSON으로 읽는다
    m = re.search(r"^\[", r.stdout or "", re.M)
    if not m:
        return None
    try:
        targets, _ = json.JSONDecoder().raw_decode(r.stdout[m.start():])
    except json.JSONDecodeError:
        return None
    for t in targets:
        s = t.get("buildSettings", {})
        if s.get("WRAPPER_EXTENSION") == "app" and s.get("PRODUCT_BUNDLE_IDENTIFIER"):
            return s["PRODUCT_BUNDLE_IDENTIFIER"]
    return None


def default_simulator():
    data = json.loads(run(["xcrun", "simctl", "list", "devices", "available", "-j"]).stdout)
    names = [d["name"] for rt, ds in sorted(data["devices"].items()) if "iOS" in rt for d in ds]
    for preferred in ("iPhone 17", "iPhone 16", "iPhone 15"):
        if preferred in names:
            return preferred
    iphones = [n for n in names if n.startswith("iPhone")]
    return iphones[-1] if iphones else "iPhone 17"


def copy_template(src, dst, values, force):
    for path in src.rglob("*"):
        rel = path.relative_to(src)
        rel = Path(str(rel).replace("_gitignore", ".gitignore"))
        target = dst / rel
        if path.is_dir():
            target.mkdir(parents=True, exist_ok=True)
            continue
        if target.exists() and not force:
            continue
        # 사용자가 작성한 테스트는 --force여도 덮어쓰지 않는다
        if target.exists() and "Flows" in rel.parts:
            continue
        text = path.read_text(encoding="utf-8")
        for k, v in values.items():
            text = text.replace("{{" + k + "}}", v)
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(text, encoding="utf-8")


# ─────────────────────────────── 명령: doctor ───────────────────────────────

def cmd_doctor(args):
    ws = find_workspace(args.workspace)
    problems = 0

    def check(cond, good, bad, hint=None):
        nonlocal problems
        if cond:
            ok(good)
        else:
            problems += 1
            print(f"❌ {bad}" + (f"\n   → {hint}" if hint else ""))

    info(f"작업공간: {ws.root}")
    xc = run(["xcodebuild", "-version"], check=False)
    check(xc.returncode == 0, (xc.stdout or "").splitlines()[0] if xc.stdout else "", "Xcode 없음",
          "Xcode 설치 후 sudo xcode-select -s /Applications/Xcode.app")
    check(shutil.which("xcodegen"), "xcodegen 설치됨", "xcodegen 없음", "brew install xcodegen")
    check(ws.project and ws.project.exists(), f"앱 프로젝트: {ws.project}", f"앱 프로젝트 없음: {ws.project}",
          "qakit.yml의 app.project 확인")
    check(bool(ws.scheme), f"scheme: {ws.scheme}", "app.scheme 비어 있음")
    check(ws.bundle_id and "TODO" not in ws.bundle_id, f"bundleId: {ws.bundle_id}", "app.bundleId 비어 있음")

    udid, state = simulator_udid(ws.simulator)
    check(udid, f"시뮬레이터: {ws.simulator} ({state})", f"시뮬레이터 '{ws.simulator}' 없음",
          "xcrun simctl list devices available")
    if udid:
        check(app_installed(udid, ws.bundle_id), "대상 앱 설치됨", "대상 앱이 시뮬레이터에 없음", "qakit build-app")

    if ws.autoid == "inject":
        check(ws.autoid_dylib.exists(), "AutoID dylib 빌드됨", "AutoID dylib 없음",
              "qakit build-app (자동으로 빌드됨)")
    else:
        info("ℹ️  autoid: embedded — 앱에 AutoID.swift가 들어가 있어야 합니다.")

    if ws.app_dir and swiftui_enabled(ws):
        if is_qa_worktree(ws.app_dir):
            ok("SwiftUI ID 삽입: QA 워크트리 확인됨")
        elif ws.swiftui == "insert":
            check(False, "", "swiftui: insert 인데 앱 폴더가 QA 워크트리가 아님 (삽입은 워크트리에서만)",
                  "qakit init <앱> --worktree 또는 qakit.yml에 swiftui: off")
        else:
            warn("SwiftUI 소스가 있지만 앱 폴더가 QA 워크트리가 아니라 SwiftUI ID를 붙이지 않습니다 (qakit init --worktree)")
        check(not ws.swiftui_manifest.exists(), "SwiftUI ID 삽입 복원 상태 정상",
              "이전 SwiftUI ID 삽입이 복원되지 않음 (워크트리 소스가 바뀐 채)", "qakit swiftui-ids --restore")
        if not SWIFTUI_IDS_BIN.exists():
            info("ℹ️  swiftui-ids 도구는 첫 qakit build-app 때 빌드됩니다 (몇 분)")

    st = worktree_status(ws) if ws.app_dir else None
    if st and st["ref"]:
        if st["behind"]:
            warn(f"QA 워크트리({st['branch']})가 {st['ref']}보다 {st['behind']}커밋 뒤처짐 → qakit worktree-update"
                 + (" (test/run 전에 자동으로 가져옴)" if ws.worktree_update == "auto" else ""))
        else:
            ok(f"QA 워크트리({st['branch']})가 {st['ref']} 기준 최신")
    if ws.secrets_path.exists():
        keys = sorted(ws.secrets().keys())
        example = ws.root / "secrets.example.txt"
        needed = sorted(Workspace.parse_keys(example)) if example.exists() else []
        missing = [k for k in needed if k not in keys]
        check(not missing, f"secrets: {', '.join(keys) or '(비어 있음)'}",
              f"secrets에 키 누락: {', '.join(missing)}", f"{ws.secrets_path}에 추가")
    else:
        warn(f"secrets 파일 없음: {ws.secrets_path} (로그인이 필요 없으면 무시)")

    check(ws.runner_dir.joinpath("project.yml").exists(), "Runner 준비됨", "Runner/project.yml 없음", "qakit init --force")
    print()
    if problems:
        fail(f"문제 {problems}개", "위 → 안내대로 고친 뒤 다시 qakit doctor")
    ok("모두 정상")


def _parse_keys(path):
    keys = []
    for raw in Path(path).read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if line and not line.startswith("#") and "=" in line:
            keys.append(line.split("=", 1)[0].strip())
    return keys


Workspace.parse_keys = staticmethod(_parse_keys)


# ─────────────────────────────── 명령: build-app ───────────────────────────────

def cmd_build_app(args):
    ws = find_workspace(args.workspace)
    with sim_lock(ws, "qakit build-app"):   # 설치하면 실행 중인 앱이 꺼지므로
        cmd_build_app_ws(ws)


def cmd_build_app_ws(ws):
    ws.results_dir.mkdir(exist_ok=True)
    ensure_autoid(ws)
    udid = ws.device["udid"] if ws.device else ensure_booted(ws)

    info(f"앱 빌드 중: {ws.scheme} ({ws.configuration}, {ws.build})" + (" · 실기기용" if ws.device else "")
         + " — 처음엔 몇 분 걸립니다")
    log_path = ws.results_dir / "build-app.log"
    cmd = ["xcodebuild", "build", *project_flag(ws.project), "-scheme", ws.scheme,
           "-configuration", ws.configuration,
           # -sdk는 주지 않는다: 모든 타깃의 SDK를 덮어써서 Swift 매크로 플러그인(macOS 실행 파일)까지
           # 시뮬레이터용으로 빌드돼 "produced malformed response"로 실패한다. -destination이 SDK를 정한다.
           "-destination", "generic/platform=iOS" if ws.device else "generic/platform=iOS Simulator",
           "-derivedDataPath", str(ws.app_build_dir)]
    if ws.device:
        cmd += ["-allowProvisioningUpdates", f"DEVELOPMENT_TEAM={device_team(ws)}"]
    state = app_state(ws)
    before = git(ws.app_dir, "status", "--porcelain", "--", *app_pathspec(ws))
    # SwiftUI 소스에 ID를 끼워 넣고 빌드한 뒤, 무슨 일이 있어도(실패·Ctrl-C) 원래대로 되돌린다
    manifest = swiftui_insert(ws)
    try:
        # 앱 레포의 Package.resolved를 고치지 않는다 (QA는 앱 레포를 수정하지 않음)
        r = run(cmd + ["-onlyUsePackageVersionsFromResolvedFile"], check=False)
        if r.returncode != 0 and "resolved" in (r.stdout or "").lower() and "error:" in (r.stdout or ""):
            warn("Package.resolved 고정 빌드 실패 → 고정 없이 다시 빌드 (앱 레포의 Package.resolved가 바뀔 수 있음)")
            r = run(cmd, check=False)
    finally:
        swiftui_restore(ws, manifest)
    log_path.write_text(r.stdout or "", encoding="utf-8")
    after = git(ws.app_dir, "status", "--porcelain", "--", *app_pathspec(ws))
    if before is not None and after != before:
        changed = sorted(set((after or "").splitlines()) - set((before or "").splitlines()))
        warn("빌드 중 앱 레포 파일이 바뀌었습니다 (QA가 만든 변경일 수 있음): " + ", ".join(c[3:] for c in changed))
    if r.returncode != 0:
        errors = [l for l in (r.stdout or "").splitlines() if "error:" in l]
        fail("앱 빌드 실패", "\n   ".join(dict.fromkeys(errors[:15])) or f"로그: {log_path}")

    app_path = find_built_app(ws)
    if not app_path:
        fail(f"빌드 결과에서 {ws.bundle_id} 앱을 찾지 못했습니다.", "qakit.yml의 bundleId/configuration 확인")
    if ws.device:
        if ws.autoid == "inject":
            embed_autoid(app_path, ws.autoid_dylib)
        device_install(ws, app_path)
        ok(f"설치: {app_path.name} → {ws.device['name']}")
        if ws.permissions:
            info("ℹ️  실기기는 권한을 미리 허용할 수 없습니다 → 처음 한 번 기기에서 허용하거나 시나리오가 팝업을 누르게 하세요 ("
                 + ", ".join(map(str, ws.permissions)) + ")")
        state["installedOn"] = udid
        save_state(ws, ws.state_name, state)
        return
    run(["xcrun", "simctl", "install", udid, str(app_path)])
    ok(f"설치: {app_path.name} → {ws.simulator}")

    for perm in ws.permissions:
        r = run(["xcrun", "simctl", "privacy", udid, "grant", str(perm), ws.bundle_id], check=False)
        (ok if r.returncode == 0 else warn)(f"권한 허용: {perm}" + ("" if r.returncode == 0 else " 실패"))
    state["installedOn"] = udid
    save_state(ws, ws.state_name, state)


def find_built_app(ws):
    products = ws.app_build_dir / "Build" / "Products"
    for app in products.glob("*-iphoneos/*.app" if ws.device else "*-iphonesimulator/*.app"):
        try:
            with open(app / "Info.plist", "rb") as f:
                if plistlib.load(f).get("CFBundleIdentifier") == ws.bundle_id:
                    return app
        except (OSError, plistlib.InvalidFileException):
            continue
    return None


# ─────────────────────────────── 명령: dump-ui ───────────────────────────────

def cmd_dump_ui(args):
    ws = find_workspace(args.workspace)
    with sim_lock(ws, "qakit dump-ui"):
        _cmd_dump_ui(ws, args)


def _cmd_dump_ui(ws, args):
    extra = {"DUMP_MODE": "attach" if args.attach else "launch", "DUMP_SETTLE": str(args.settle)}
    if args.wait_id:
        extra["DUMP_WAIT_ID"] = args.wait_id
    dump = ws.results_dir / "ui-dump.txt"
    if dump.exists():
        dump.unlink()
    if has_swift_runner(ws) and not ws.device:
        success, xcresult, output = run_tests(ws, [DUMP_TEST], extra, label="dump", quiet=True)
    else:
        success, xcresult, output = run_scenario_runner(ws, "test_dump", extra, label="dump", quiet=True)
    if not dump.exists():
        print(summarize(xcresult, masker(ws.secrets())))
        fail("화면 덤프 실패")
    text = masker(ws.secrets())(dump.read_text(encoding="utf-8"))
    dump.write_text(text, encoding="utf-8")
    # gen-ids --verify가 쓰도록 덤프를 모아 둔다
    archive = ws.results_dir / "dumps"
    archive.mkdir(exist_ok=True)
    (archive / f"ui-dump-{timestamp()}.txt").write_text(text, encoding="utf-8")
    header = [l for l in text.splitlines() if l.startswith("#")]
    for l in header[2:]:
        info(l.lstrip("# "))
    ok(f"저장: {dump}")
    if args.print:
        print(text)


# ─────────────────────────────── 명령: test ───────────────────────────────

def reset_app(ws, udid):
    """앱 재설치 + 키체인 초기화 → 처음 설치한 상태 (로그아웃)."""
    app_path = find_built_app(ws)
    if not app_path:
        fail("재설치할 앱 빌드가 없습니다.", "qakit build-app")
    if ws.device:
        run(["xcrun", "devicectl", "device", "uninstall", "app", "--device", ws.device["id"], ws.bundle_id], check=False)
        device_install(ws, app_path)
        ok("앱 초기화 (재설치 — 실기기는 키체인을 지울 수 없어 저장된 로그인 정보가 남을 수 있음)")
        return
    run(["xcrun", "simctl", "terminate", udid, ws.bundle_id], check=False)
    run(["xcrun", "simctl", "uninstall", udid, ws.bundle_id], check=False)
    run(["xcrun", "simctl", "keychain", udid, "reset"], check=False)
    run(["xcrun", "simctl", "install", udid, str(app_path)])
    for perm in ws.permissions:
        run(["xcrun", "simctl", "privacy", udid, "grant", str(perm), ws.bundle_id], check=False)
    ok("앱 초기화 (재설치 + 키체인 초기화)")


def cmd_test(args):
    ws = find_workspace(args.workspace)
    try:
        with sim_lock(ws, "qakit test " + " ".join(args.filters or [])):
            _cmd_test(ws, args)
    finally:
        update_readme(ws)


def _cmd_test(ws, args):
    if ws.device:
        fail("qakit test는 아직 실기기를 지원하지 않습니다.", "실기기는 시나리오로: qakit run <시나리오> --device")
    if not has_swift_runner(ws):
        fail("Swift 테스트가 없는 작업공간입니다.", "시나리오는 qakit run <시나리오>, 목록은 ls scenarios/")
    only = args.filters or []
    extra = {}
    auto_sync(ws)
    if args.reset:
        reset_app(ws, ws.device["udid"] if ws.device else ensure_booted(ws))
        extra["RESET"] = "1"
    info(f"테스트 실행: {', '.join(only) if only else '전체'}")
    success, xcresult, _ = run_tests(ws, only, extra, label="test")
    print()
    if success:
        ok(f"통과 — 결과: {xcresult}")
        return
    print(summarize(xcresult, masker(ws.secrets())))
    fail("실패", f"자세한 결과: {xcresult}")


# ─────────────────────────────── 명령: summarize ───────────────────────────────

def cmd_summarize(args):
    ws = find_workspace(args.workspace)
    path = Path(args.xcresult).resolve() if args.xcresult else (ws.results_dir / "latest.xcresult").resolve()
    if not path.exists():
        fail(f"결과 파일 없음: {path}", "qakit test를 먼저 실행하세요.")
    print(summarize(path, masker(ws.secrets())))


def summarize(xcresult, mask):
    if not Path(xcresult).exists():
        return "(결과 파일 없음 — 빌드 단계에서 실패했을 수 있음)"
    tree = json.loads(run(["xcrun", "xcresulttool", "get", "test-results", "tests",
                           "--path", str(xcresult)]).stdout)
    cases = []

    def walk(node):
        if node.get("nodeType") == "Test Case":
            cases.append(node)
        for c in node.get("children", []):
            walk(c)
    for n in tree.get("testNodes", []):
        walk(n)

    passed = [c for c in cases if c.get("result") == "Passed"]
    failed = [c for c in cases if c.get("result") == "Failed"]
    out = [f"── 결과: 통과 {len(passed)} / 실패 {len(failed)} / 전체 {len(cases)}"]
    if not failed:
        return "\n".join(out)

    attachments = export_attachments(xcresult)
    for c in failed:
        test_id = c.get("nodeIdentifier", c.get("name"))
        out.append(f"\n❌ {test_id}")
        for child in c.get("children", []):
            if child.get("nodeType") == "Failure Message":
                out.append(f"   원인: {child.get('name')}")
        steps = last_steps(xcresult, test_id)
        if steps:
            out.append("   마지막 단계:")
            out += [f"     - {s}" for s in steps]
        tree_text = attachments.get(test_id, {}).get("qakit-ui-tree")
        if tree_text:
            out.append("   실패 시점 화면 구조 (ID/라벨 있는 요소):")
            compact = compact_tree(tree_text)
            if len(compact) > 60:  # 팝업 등 최상단 요소는 보통 끝에 있으므로 뒤쪽을 남긴다
                compact = ["...(앞 %d줄 생략)" % (len(compact) - 60)] + compact[-60:]
            out += ["     " + l for l in compact]
        shot = attachments.get(test_id, {}).get("qakit-screenshot-path")
        if shot:
            out.append(f"   스크린샷: {shot}")
    return mask("\n".join(out))


def export_attachments(xcresult):
    dest = Path(xcresult).parent / (Path(xcresult).stem + "-attachments")
    if dest.exists():
        shutil.rmtree(dest)
    dest.mkdir()
    r = run(["xcrun", "xcresulttool", "export", "attachments", "--path", str(xcresult),
             "--output-path", str(dest)], check=False)
    manifest = dest / "manifest.json"
    result = {}
    if r.returncode != 0 or not manifest.exists():
        return result
    for entry in json.loads(manifest.read_text()):
        tid = entry.get("testIdentifier")
        for a in entry.get("attachments", []):
            name = a.get("suggestedHumanReadableName", "")
            f = dest / a.get("exportedFileName", "")
            if name.startswith("qakit-ui-tree"):
                result.setdefault(tid, {})["qakit-ui-tree"] = f.read_text(encoding="utf-8", errors="replace")
            elif name.startswith("qakit-screenshot"):
                result.setdefault(tid, {})["qakit-screenshot-path"] = str(f)
    return result


def last_steps(xcresult, test_id, limit=8):
    r = run(["xcrun", "xcresulttool", "get", "test-results", "activities", "--path", str(xcresult),
             "--test-id", test_id, "--compact"], check=False)
    if r.returncode != 0:
        return []
    titles = []

    def walk(acts, depth):
        for a in acts:
            t = (a.get("title") or "").strip()
            noise = re.match(r"^(Find|Check|Wait for|Synthesize|Requesting|Get |Snapshot|Collecting|Added attachment|"
                             r"kXCT|qakit-|Capturing|Start Test|Set Up|Tear Down|Debug description|App UI hierarchy|UI Snapshot)", t)
            if t and not noise:
                titles.append(("  " * min(depth, 3)) + t)
            walk(a.get("childActivities", []), depth + 1)
    try:
        for run_ in json.loads(r.stdout).get("testRuns", []):
            walk(run_.get("activities", []), 0)
    except json.JSONDecodeError:
        return []
    return titles[-limit:]


def compact_tree(text):
    """XCUITest debugDescription → ID/라벨이 있는 줄만, 좌표 축약."""
    lines = []
    for raw in text.splitlines():
        m = re.match(r"^(\s*)(\w[\w ]*?), 0x[0-9a-f]+, \{\{([-\d.]+), ([-\d.]+)\}, \{([-\d.]+), ([-\d.]+)\}\}(.*)$", raw)
        if not m:
            continue
        indent, kind, x, y, w, h, rest = m.groups()
        if "identifier:" not in rest and "label:" not in rest:
            continue
        # 라벨 없는 컨테이너/이미지는 생략 (덤프가 필요하면 qakit dump-ui)
        if kind.strip() in ("Other", "Image", "ScrollView", "Window") and "label:" not in rest:
            continue
        rest = re.sub(r", (Selected|Disabled|Enabled)", r" \1", rest)
        lines.append(f"{indent}{kind}{rest} @{int(float(x))},{int(float(y))} {int(float(w))}x{int(float(h))}")
    return lines


# ─────────────────────────────── 앱 상태 / 동기화 ───────────────────────────────

def git(app_dir, *args):
    r = run(["git", "-C", str(app_dir), *args], check=False)
    return r.stdout.strip() if r.returncode == 0 else None


def app_state(ws):
    """앱 소스 상태 스냅샷: 경로, 브랜치, 커밋, 미커밋 변경 해시."""
    d = ws.app_dir
    state = {"appPath": str(ws.project), "scheme": ws.scheme, "configuration": ws.configuration}
    branch = git(d, "rev-parse", "--abbrev-ref", "HEAD")
    if branch is not None:
        state["branch"] = branch
        state["commit"] = git(d, "rev-parse", "--short", "HEAD")
        spec = app_pathspec(ws)
        status = git(d, "status", "--porcelain", "--untracked-files=normal", "--", *spec) or ""
        diff = git(d, "diff", "HEAD", "--", *spec) or ""
        state["dirty"] = hashlib.sha1((status + diff).encode()).hexdigest()[:12] if status else ""
        state["dirtyFiles"] = len(status.splitlines()) if status else 0
    else:
        # git이 아니면 Swift 파일 수정 시각으로
        h = hashlib.sha1()
        for f in sorted(gen_ids.iter_swift_files([d])):
            h.update(f"{f}:{f.stat().st_mtime}".encode())
        state["sourceHash"] = h.hexdigest()[:12]
    return state


def app_pathspec(ws):
    """작업공간이 앱 레포 안(QA 폴더)이면 앱 변경 감지에서 제외한다."""
    try:
        rel = ws.root.relative_to(ws.app_dir)
        return [".", f":(exclude){rel}"]
    except ValueError:
        return ["."]


SAME_KEYS = ("appPath", "scheme", "configuration", "commit", "dirty", "sourceHash")


def load_state(ws, name):
    f = ws.state_dir / f"{name}.json"
    return json.loads(f.read_text()) if f.exists() else None


def save_state(ws, name, data):
    ws.state_dir.mkdir(exist_ok=True)
    data = dict(data, savedAt=datetime.datetime.now().isoformat(timespec="seconds"))
    (ws.state_dir / f"{name}.json").write_text(json.dumps(data, ensure_ascii=False, indent=2))


def describe_change(old, new):
    if not old:
        return "빌드 기록 없음"
    parts = []
    if old.get("appPath") != new.get("appPath"):
        parts.append(f"앱 경로 {Path(old.get('appPath', '')).parent.name} → {Path(new['appPath']).parent.name}")
    if old.get("branch") != new.get("branch"):
        parts.append(f"브랜치 {old.get('branch') or '(git 아님)'} → {new.get('branch') or '(git 아님)'}")
    elif old.get("commit") != new.get("commit"):
        parts.append(f"커밋 {old.get('commit')} → {new.get('commit')}")
    if old.get("dirty") != new.get("dirty"):
        parts.append(f"미커밋 변경 {new.get('dirtyFiles', 0)}개 파일")
    if old.get("sourceHash") != new.get("sourceHash"):
        parts.append("소스 변경")
    for k in ("scheme", "configuration"):
        if old.get(k) != new.get(k):
            parts.append(f"{k} {old.get(k)} → {new.get(k)}")
    return ", ".join(parts)


def app_changed(ws):
    old = load_state(ws, ws.state_name)
    new = app_state(ws)
    changed = not old or any(old.get(k) != new.get(k) for k in SAME_KEYS)
    return changed, describe_change(old, new) if changed else "", new


# ─────────────────────────────── QA 워크트리 최신화 ───────────────────────────────
# 원칙: QA 워크트리 브랜치(qa/workspace)는 그대로 유지한다. 사용자가 명시적으로 요청하지 않는 한
# 다른 브랜치로 병합하지 않고 push하지 않는다. 따라갈 브랜치(develop)가 앞서 있으면 그 커밋을 QA 쪽으로 가져온다.

def _git_quiet_fetch(repo_dir, branch):
    if not git(repo_dir, "remote"):
        return
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0")
    try:
        subprocess.run(["git", "-C", str(repo_dir), "fetch", "--quiet", "origin", branch],
                       env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
    except (subprocess.TimeoutExpired, OSError):
        pass


def worktree_status(ws, base=None, fetch=True):
    """QA 워크트리가 따라갈 브랜치보다 몇 커밋 뒤처졌는지. QA 워크트리가 아니면 None."""
    d = ws.app_dir
    if not d or APP_OVERRIDE or not is_qa_worktree(d):
        return None
    base = base or ws.worktree_base
    if fetch:
        _git_quiet_fetch(d, base)
    refs = [r for r in (f"origin/{base}", base) if git(d, "rev-parse", "--verify", "--quiet", r) is not None]
    ref = refs[0] if refs else None
    for other in refs[1:]:   # 로컬이 원격보다 앞서 있으면 로컬을 쓴다
        if git(d, "merge-base", "--is-ancestor", ref, other) is not None:
            ref = other
    branch = git(d, "rev-parse", "--abbrev-ref", "HEAD")
    behind = int(git(d, "rev-list", "--count", f"HEAD..{ref}") or 0) if ref else 0
    return {"base": base, "ref": ref, "branch": branch, "behind": behind}


def update_worktree(ws, base=None, check_only=False, strict=True):
    """따라갈 브랜치의 새 커밋을 QA 워크트리로 가져온다 (merge, push 안 함). strict=False면 실패해도 경고만."""
    def stop(msg, hint=None):
        if strict:
            fail(msg, hint)
        warn(msg + (f" → {hint}" if hint else ""))
        return False

    st = worktree_status(ws, base)
    if st is None:
        return stop("앱 폴더가 QA 워크트리가 아닙니다.", "qakit init <앱> --worktree 로 만든 작업공간에서 실행하세요")
    if not st["ref"]:
        return stop(f"따라갈 브랜치 '{st['base']}'를 찾지 못했습니다.", "qakit.yml의 worktree.base 또는 --from <브랜치>")
    d, ref, branch, n = ws.app_dir, st["ref"], st["branch"], st["behind"]
    if n == 0:
        if strict:
            ok(f"QA 워크트리({branch})가 {ref} 기준 최신입니다")
        return True
    if check_only:
        warn(f"QA 워크트리({branch})가 {ref}보다 {n}커밋 뒤처져 있습니다 → qakit worktree-update")
        return True
    dirty = git(d, "status", "--porcelain", "--untracked-files=no", "--", *app_pathspec(ws))
    if dirty:
        return stop(f"QA 워크트리({branch})가 {ref}보다 {n}커밋 뒤처졌지만, 앱 소스에 미커밋 변경이 있어 가져오지 않았습니다.",
                    "변경을 커밋하거나 정리한 뒤 qakit worktree-update")
    if ws.swiftui_manifest.exists():
        return stop("SwiftUI ID 삽입이 복원되지 않은 상태라 가져오지 않았습니다.", "qakit swiftui-ids --restore 후 다시")
    before = git(d, "rev-parse", "--short", "HEAD")
    info(f"🔄 QA 워크트리({branch})가 {ref}보다 {n}커밋 뒤처짐 → {ref}에서 가져와 최신화 (QA 브랜치 유지, push 안 함)")
    r = run(["git", "-C", str(d), "merge", "--no-edit", "-m",
             f"Merge {ref} into {branch} (qakit worktree-update)", ref], check=False)
    if r.returncode != 0:
        run(["git", "-C", str(d), "merge", "--abort"], check=False)
        conflicts = [l for l in (r.stdout or "").splitlines() if "CONFLICT" in l][:5]
        return stop(f"{ref}를 가져오다 충돌이 나서 되돌렸습니다." + ("\n   " + "\n   ".join(conflicts) if conflicts else ""),
                    f"직접 해결: git -C {d} merge {ref}")
    ok(f"{ref}의 {n}커밋을 가져옴 ({before} → {git(d, 'rev-parse', '--short', 'HEAD')}). 다음 test/run이 앱을 다시 빌드합니다")
    return True


def follow_worktree(ws):
    """test/run 전에: QA 워크트리가 따라갈 브랜치보다 뒤처졌으면 가져온다 (qakit.yml worktree.update)."""
    if ws.worktree_update == "off":
        return
    update_worktree(ws, check_only=ws.worktree_update == "warn", strict=False)


def cmd_worktree_update(args):
    ws = find_workspace(args.workspace)
    update_worktree(ws, base=args.base, check_only=args.check)


def auto_sync(ws):
    follow_worktree(ws)
    if ws.sync_mode == "off":
        return
    changed, why, _ = app_changed(ws)
    if not changed:
        return
    if ws.sync_mode == "warn":
        warn(f"앱이 마지막 빌드 이후 바뀌었습니다 ({why}). 최신 상태로 테스트하려면 qakit sync")
        return
    info(f"🔄 앱 변경 감지 ({why}) → 동기화")
    do_sync(ws, compile_check=False)


def cmd_sync(args):
    ws = find_workspace(args.workspace)
    do_sync(ws, compile_check=True, force_build=args.rebuild, skip_build=args.skip_build)


def do_sync(ws, compile_check=True, force_build=False, skip_build=False):
    changed, why, state = app_changed(ws)
    branch = state.get("branch")
    info(f"앱: {ws.project}" + (f"  [{branch} @ {state.get('commit')}"
                                 + (f", 미커밋 {state.get('dirtyFiles')}개" if state.get("dirty") else "") + "]"
                                 if branch else ""))
    # 1. 앱 빌드/설치
    if skip_build:
        info("1) 앱 빌드 생략 (--skip-build)" + (f" — 주의: 설치된 앱과 소스가 다름 ({why})" if changed else ""))
    elif changed or force_build:
        info(f"1) 앱 재빌드: {why or '요청'}")
        cmd_build_app_ws(ws)
    else:
        ok("1) 설치된 앱이 최신")
    # 2. ID 재생성
    info("2) ID 상수 재생성")
    generate_ids(ws, quiet=False)
    # 3. 테스트 코드 컴파일 확인
    broken = False
    if compile_check:
        info("3) 테스트 코드 컴파일 확인")
        udid = ensure_booted(ws)
        ensure_runner(ws)
        r = run(["xcodebuild", "build-for-testing", "-project", str(ws.runner_project),
                 "-scheme", RUNNER_SCHEME, "-destination", f"id={udid}",
                 "-derivedDataPath", str(ws.build_dir / "runner")], check=False)
        if r.returncode == 0:
            ok("   테스트 코드 정상")
        else:
            errors = list(dict.fromkeys(l.strip() for l in r.stdout.splitlines() if "error:" in l))
            id_errors = [e for e in errors if "QAID" in e]
            print(f"❌ 테스트 코드 컴파일 실패 {len(errors)}건" + (f" (ID 변경 때문 {len(id_errors)}건)" if id_errors else ""))
            for e in errors[:15]:
                print("   " + re.sub(r"^.*/Runner/", "Runner/", e))
            print("   → 위 Page/Flow에서 바뀐 ID를 새 QAID로 고치세요 (2)의 삭제/추가 목록 참고)")
            broken = True
    # 4. 브랜치 안내
    workspace_branch = git(ws.root, "rev-parse", "--abbrev-ref", "HEAD")
    if branch and workspace_branch and workspace_branch != branch:
        if git(ws.root, "rev-parse", "--verify", "--quiet", branch) is not None:
            warn(f"작업공간 브랜치({workspace_branch})가 앱 브랜치({branch})와 다릅니다. "
                 f"같은 이름의 작업공간 브랜치가 있습니다: git -C {ws.root} switch {branch}")
    if broken:
        fail("동기화는 됐지만 테스트 코드 수정이 필요합니다.")
    ok("동기화 완료")


# ─────────────────────────────── 명령: gen-ids ───────────────────────────────

def cmd_swiftui_ids(args):
    ws = find_workspace(args.workspace)
    if args.restore:
        if not ws.swiftui_manifest.exists():
            ok("복원할 삽입이 없습니다 (manifest 없음)")
            return
        swiftui_restore(ws, ws.swiftui_manifest)
        ok("SwiftUI ID 삽입을 되돌렸습니다")
    elif args.insert:
        manifest = swiftui_insert(ws)
        if manifest is None:
            warn("SwiftUI 소스가 없거나 swiftui: off 입니다")
        else:
            ok(f"삽입한 채 둡니다. 확인 뒤: qakit swiftui-ids --restore  (git -C {ws.app_dir} diff 로 보기)")
    else:
        if ws.swiftui == "off":
            warn("qakit.yml: swiftui: off")
        items = swiftui_list(ws)
        for x in items:
            rel = os.path.relpath(x["file"], ws.app_dir)
            print(f'{x["id"]}\t{x["kind"]}{"  (호출부 ID가 우선)" if x.get("overridable") else ""}\t{rel}:{x["line"]}')
        info(f"SwiftUI ID {len(items)}개")


def cmd_gen_ids(args):
    ws = find_workspace(args.workspace)
    trees, model = generate_ids(ws, quiet=False)
    if args.verify:
        verify_ids(ws, trees, model)


def generate_ids(ws, quiet=True):
    sources = ws.id_sources or [ws.app_dir]
    trees, model, nfiles = gen_ids.build(sources, exclude=[ws.root])
    swiftui = swiftui_list(ws)
    if swiftui:
        gen_ids.merge_ids(trees, [x["id"] for x in swiftui], kind="swiftui")
    ids = sorted(gen_ids.all_ids(trees))
    state = app_state(ws)
    note = f"앱: {ws.project.parent.name}" + (f" [{state.get('branch')} @ {state.get('commit')}]" if state.get("branch") else "")
    ws.ids_file.parent.mkdir(parents=True, exist_ok=True)
    ws.ids_file.write_text(gen_ids.render_swift(trees, note), encoding="utf-8")

    prev = load_state(ws, "ids")
    prev_ids = set(prev["ids"]) if prev else None
    save_state(ws, "ids", {"ids": ids, "app": note})
    if quiet:
        return trees, model
    info(f"   소스 {nfiles}개 → ID {len(ids)}개" + (f" (SwiftUI {len(swiftui)}개 포함)" if swiftui else "") + f" → {ws.ids_file.relative_to(ws.root)}")
    if prev_ids is not None:
        added = sorted(set(ids) - prev_ids)
        removed = sorted(prev_ids - set(ids))
        if not added and not removed:
            ok("   ID 변경 없음")
        else:
            info(f"   ID 변경: 추가 {len(added)}, 삭제 {len(removed)}")
            for x in removed[:30]:
                print(f"     - {x}")
            for x in added[:30]:
                print(f"     + {x}")
            if len(removed) > 30 or len(added) > 30:
                print("     ...(일부 생략)")
            used = used_ids(ws)
            broken = sorted(used & set(removed))
            if broken:
                warn(f"   테스트에서 쓰던 ID가 삭제됨: {', '.join(broken)}")
    return trees, model


def used_ids(ws):
    """테스트 코드에 문자열로 직접 쓴 ID (QAID 상수로 바꾸지 않은 것)."""
    found = set()
    for f in (ws.runner_dir / "UITests").rglob("*.swift") if has_swift_runner(ws) else []:
        if "Generated" in f.parts:
            continue
        found |= set(re.findall(r'"([A-Z]\w*(?:\.\w+)+)"', f.read_text(encoding="utf-8", errors="replace")))
    return found


def verify_ids(ws, trees, model):
    dumps = sorted((ws.results_dir / "dumps").glob("*.txt"))
    if (ws.results_dir / "ui-dump.txt").exists():
        dumps.append(ws.results_dir / "ui-dump.txt")
    if not dumps:
        fail("비교할 화면 덤프가 없습니다.", "qakit dump-ui 를 화면별로 몇 번 실행한 뒤 다시 시도하세요.")
    matched, missing, external = gen_ids.verify(gen_ids.all_ids(trees), model, dumps, gen_ids.id_types(trees))
    info(f"검증 (덤프 {len(dumps)}개): 일치 {len(matched)}, 불일치 {len(missing)}, 앱 소스 밖·위치 규칙·선언 타입 차이 {len(external)}")
    for x in missing:
        print(f"   ❌ 런타임에만 있음: {x}")
    if missing:
        fail("생성 ID와 런타임 ID가 다릅니다.", "AutoID 규칙과 gen_ids.py 규칙 차이 — 도구 버그로 보고하세요.")
    ok("생성 ID가 런타임 ID와 일치")


# ─────────────────────────────── 시나리오 실행 (파일만으로) ───────────────────────────────

def ensure_scenario_runner(udid):
    """도구의 범용 시나리오 실행기를 필요할 때만 빌드한다 (앱마다 프로젝트를 만들지 않음)."""
    h = hashlib.sha1()
    for base in (KIT_DIR / "Sources" / "QAKit", KIT_DIR / "ScenarioRunner"):
        for f in sorted(base.rglob("*")):
            if f.is_file() and ".xcodeproj" not in str(f):
                h.update(str(f.relative_to(KIT_DIR)).encode())
                h.update(f.read_bytes())
    h.update(run(["xcodebuild", "-version"], check=False).stdout.encode())
    stamp = SCENARIO_BUILD / ".stamp"
    xctestruns = list((SCENARIO_BUILD / "Build" / "Products").glob("*.xctestrun"))
    if xctestruns and stamp.exists() and stamp.read_text() == h.hexdigest():
        return xctestruns[0]
    info("시나리오 실행기 빌드 중 (도구가 바뀌었을 때 한 번)...")
    run(["xcodegen", "generate", "--quiet", "--spec", str(KIT_DIR / "ScenarioRunner" / "project.yml"),
         "--project", str(KIT_DIR / "ScenarioRunner")])
    r = run(["xcodebuild", "build-for-testing", "-project", str(SCENARIO_PROJECT), "-scheme", "ScenarioTests",
             "-destination", f"id={udid}", "-derivedDataPath", str(SCENARIO_BUILD)], check=False)
    if r.returncode != 0:
        errors = [l for l in (r.stdout or "").splitlines() if "error:" in l]
        fail("시나리오 실행기 빌드 실패", "\n   ".join(dict.fromkeys(errors[:10])))
    stamp.write_text(h.hexdigest())
    return list((SCENARIO_BUILD / "Build" / "Products").glob("*.xctestrun"))[0]


def app_prefs_path(udid, bundle_id):
    """시뮬레이터 안 앱의 UserDefaults 파일 (시나리오의 pref 조건·read-pref용). 앱을 재설치하면 바뀌므로 실행 직전에 구한다."""
    r = run(["xcrun", "simctl", "get_app_container", udid, bundle_id, "data"], check=False)
    if r.returncode != 0:
        return None
    return str(Path(r.stdout.strip()) / "Library" / "Preferences" / f"{bundle_id}.plist")


def run_scenario_runner(ws, method, extra_env, label, quiet=False, history_name=None, run_dir=None, on_line=None):
    ws.results_dir.mkdir(exist_ok=True)
    ensure_autoid(ws)
    extra_env = dict(extra_env or {})
    if ws.device:
        udid = ws.device["udid"]
        if not device_app_installed(ws):
            fail(f"{ws.device['name']}에 {ws.bundle_id}가 설치되어 있지 않습니다.", "qakit build-app --device ...")
        xctestrun = ensure_device_runner(device_team(ws))
        # 기기 안 실행기는 Mac 파일을 못 읽는다 → 시나리오를 내용째 넘긴다
        if extra_env.get("SCENARIO_JSON"):
            extra_env["SCENARIO_B64"] = base64.b64encode(Path(extra_env.pop("SCENARIO_JSON")).read_bytes()).decode()
    else:
        udid = ensure_booted(ws)
        if not app_installed(udid, ws.bundle_id):
            fail(f"시뮬레이터에 {ws.bundle_id}가 설치되어 있지 않습니다.", "qakit build-app")
        xctestrun = ensure_scenario_runner(udid)
        prefs = app_prefs_path(udid, ws.bundle_id)
        if prefs:
            extra_env["APP_PREFS"] = prefs
    ts = timestamp()
    rd = run_dir or new_run_dir(ws, label, history_name)
    xcresult = rd / "result.xcresult"
    cmd = ["xcodebuild", "test-without-building", "-xctestrun", str(xctestrun),
           "-destination", f"id={udid}", "-resultBundlePath", str(xcresult),
           "-only-testing", f"ScenarioTests/ScenarioTests/{method}"]
    result = execute_xctest(ws, cmd, extra_env, label, ts, xcresult, quiet, history_name, on_line=on_line)
    if ws.device and xcresult.exists():
        extract_device_files(ws, xcresult, rd)
    return result


def load_checked_scenario(ws, name, strict=True):
    path = scenario_tools.find_scenario(ws.root, name)
    if not path:
        listing = ", ".join(p.name for p in sorted((ws.root / "scenarios").glob("*.qa.yml"))) or "(없음)"
        fail(f"시나리오 '{name}'을(를) 찾지 못했습니다.", f"scenarios/ 목록: {listing}")
    try:
        scenario = scenario_tools.load_scenario(path, ws.root)
    except scenario_tools.YamlError as e:
        fail(f"시나리오 형식 오류: {e}")
    trees, model = generate_ids(ws, quiet=True)
    unknown = scenario_tools.check_ids(scenario, set(gen_ids.all_ids(trees)), extra_ok=("Mapbox",))
    if unknown:
        msg = "앱에 없는 ID: " + ", ".join(unknown)
        if strict:
            fail(msg, "앱에서 이름이 바뀌었는지 Generated/QAIDs.swift 또는 qakit dump-ui로 확인하세요")
        warn(msg)
    return path, scenario


def cmd_check(args):
    ws = find_workspace(args.workspace)
    names = args.scenarios or [p.name for p in sorted((ws.root / "scenarios").glob("*.qa.yml"))]
    for n in names:
        path, scenario = load_checked_scenario(ws, n)
        ok(f"{path.name}: 단계 {count_steps(scenario['steps'])}개, ID 확인 완료")
    update_readme(ws, quiet=False)


def count_steps(steps):
    n = 0
    for s in steps:
        n += 1
        if isinstance(s, dict):
            for k in ("steps", "then", "else"):
                if isinstance(s.get(k), list):
                    n += count_steps(s[k])
    return n


def cmd_run(args):
    ws = find_workspace(args.workspace)
    try:
        with sim_lock(ws, f"qakit run {args.scenario}"):
            _cmd_run(ws, args)
    finally:
        update_readme(ws)


# ─────────────────────────────── 성능 측정 (run --bench) ───────────────────────────────

def sim_app_pid(udid, bundle_id):
    """시뮬레이터에서 실행 중인 앱의 PID (Mac에서 보이는 프로세스 번호와 같다)."""
    out = run(["xcrun", "simctl", "spawn", udid, "launchctl", "list"], check=False).stdout or ""
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) >= 3 and parts[2].startswith(f"UIKitApplication:{bundle_id}[") and parts[0].strip().isdigit():
            return int(parts[0])
    return None


def _cpu_seconds(pid):
    """프로세스가 지금까지 쓴 CPU 시간(초). ps의 time 열 ([[dd-]hh:]mm:ss.cc)."""
    r = run(["ps", "-o", "time=,rss=", "-p", str(pid)], check=False)
    if r.returncode != 0 or not r.stdout.strip():
        return None, None
    cpu, rss = r.stdout.split()[:2]
    days, _, rest = cpu.rpartition("-")
    total = 0.0
    for part in rest.split(":"):
        total = total * 60 + float(part)
    return total + (int(days) * 86400 if days else 0), int(rss) / 1024.0


# 함수별 CPU: macOS 기본 명령 sample로 SAMPLE_INTERVAL_MS마다 앱의 호출 스택을 찍는다 (권한 불필요).
# 측정이 1분 이하면 전체를, 더 길면 SAMPLE_EVERY초마다 SAMPLE_WINDOW초씩 찍는다.
# 1ms로 찍으면 찍는 동안 앱 CPU가 7%p쯤 올라가 CPU·메모리 기록이 흐려진다 (10ms는 1%p 안팎)
SAMPLE_INTERVAL_MS = 10
SAMPLE_WINDOW = 20
SAMPLE_EVERY = 180
# 스택 맨 위가 이 함수면 그 스레드는 잠자며 기다리는 중 (CPU를 쓰지 않음)
SAMPLE_IDLE = {
    "__workq_kernreturn", "__psynch_cvwait", "__psynch_mutexwait", "mach_msg2_trap", "mach_msg_trap",
    "semaphore_wait_trap", "semaphore_timedwait_trap", "__accept", "__select", "__pselect", "__semwait_signal",
    "kevent", "kevent64", "kevent_id", "__ulock_wait", "__ulock_wait2", "poll", "__sigsuspend", "__wait4",
    "__recvfrom", "__recvmsg", "__sleep", "nanosleep", "read", "__read_nocancel", "recv", "start_wqthread",
}
# 앱 코드 목록에서 뺄 것: 어떤 동작이든 거쳐 가는 시작점·접착 코드
SAMPLE_APP_SKIP = ("main", "static AppDelegate.$main()", "static UIApplicationDelegate.main()")
SAMPLE_APP_SKIP_PREFIX = ("thunk for ", "partial apply for ", "protocol witness for ", "DYLD-STUB$$", "__swift_",
                          "merged ", "reabstraction thunk")
_SAMPLE_LINE = re.compile(r"^([ +|!:]*?)(\d+) (.+)$")


def sample_windows(seconds):
    """측정 시간 → [(시작 초, 길이 초)]."""
    if seconds <= 60:
        return [(0, int(seconds))]
    return [(t, min(SAMPLE_WINDOW, int(seconds) - t)) for t in range(0, int(seconds), SAMPLE_EVERY)
            if int(seconds) - t >= 5]


def parse_sample(path):
    """sample 결과의 호출 트리 → 대기를 뺀 'CPU를 쓴' 샘플 집계.
    self: 스택 맨 위(직접 CPU를 쓴) 함수별 개수, app: 앱 함수별로 그 아래 호출까지 포함한 개수."""
    lines = Path(path).read_text(errors="replace").splitlines()
    binary = next((l.split()[1] for l in lines[:5] if l.startswith("Process:")), "app")
    try:
        lines = lines[lines.index("Call graph:") + 1:]
    except ValueError:
        return None
    depth, count, name, lib, src, parent = [], [], [], [], [], []
    stack = []
    for line in lines:
        if not line.strip():
            break
        m = _SAMPLE_LINE.match(line)
        if not m:
            continue
        d, rest = len(m.group(1)), m.group(3)
        fn, _, tail = rest.partition("  (in ")
        while stack and depth[stack[-1]] >= d:
            stack.pop()
        parent.append(stack[-1] if stack else None)
        stack.append(len(depth))
        depth.append(d)
        count.append(int(m.group(2)))
        name.append(fn.strip())
        lib.append(tail.split(")", 1)[0] if tail else "")
        src.append(rest.rsplit("]  ", 1)[1].strip() if "]  " in rest else "")
    n = len(depth)
    active = list(count)                      # 자기 자신 = 개수 − 자식 개수 합
    for i in range(n):
        if parent[i] is not None:
            active[parent[i]] -= count[i]
    for i in range(n):
        if not lib[i] or name[i] in SAMPLE_IDLE:
            active[i] = 0                     # 스레드 머리줄 / 잠자며 대기
    incl = list(active)                       # 아래 호출까지 포함한 CPU 샘플
    for i in reversed(range(n)):
        if parent[i] is not None:
            incl[parent[i]] += incl[i]
    self_counts, app_counts, app_src = {}, {}, {}
    for i in range(n):
        if active[i]:
            key = name[i] if name[i] != "???" else f"??? ({lib[i]})"
            self_counts[(key, lib[i])] = self_counts.get((key, lib[i]), 0) + active[i]
        if incl[i] and lib[i] == binary and name[i] not in SAMPLE_APP_SKIP \
                and not name[i].startswith(SAMPLE_APP_SKIP_PREFIX):
            a = parent[i]                     # 재귀로 위에 같은 함수가 있으면 두 번 세지 않는다
            while a is not None and name[a] != name[i]:
                a = parent[a]
            if a is None:
                app_counts[name[i]] = app_counts.get(name[i], 0) + incl[i]
                if src[i] and not src[i].startswith("/<compiler"):
                    app_src.setdefault(name[i], src[i])
    return {"active": sum(active), "self": self_counts, "app": app_counts, "src": app_src, "binary": binary}


def sample_top(files, limit=10):
    """여러 sample 결과를 합쳐 상위 목록."""
    total, selfc, appc, srcs, binary = 0, {}, {}, {}, "app"
    for f in files:
        r = parse_sample(f)
        if not r:
            continue
        total += r["active"]
        binary = r["binary"]
        for k, v in r["self"].items():
            selfc[k] = selfc.get(k, 0) + v
        for k, v in r["app"].items():
            appc[k] = appc.get(k, 0) + v
        for k, v in r["src"].items():
            srcs.setdefault(k, v)
    if not total:
        return None
    pct = lambda v: v * 100.0 / total
    return {
        "active": total, "binary": binary,
        "self": [(fn, "앱" if lb == binary else lb, pct(v)) for (fn, lb), v in
                 sorted(selfc.items(), key=lambda x: -x[1])[:limit]],
        "app": [(fn, srcs.get(fn, ""), pct(v)) for fn, v in sorted(appc.items(), key=lambda x: -x[1])[:limit]],
    }


BENCH_UNITS = {"s": 1, "초": 1, "m": 60, "분": 60, "h": 3600, "시간": 3600}
BENCH_MIN_SECONDS = 5


def parse_duration(text):
    """'30s'·'5분'·'1h30m'·'1시간30분'·'0.5m' → 초. 단위가 없거나 형식이 틀리면 ValueError."""
    s = str(text).strip().lower().replace(" ", "")
    parts = re.findall(r"(\d+(?:\.\d+)?)(시간|초|분|h|m|s)", s)
    if not s or not parts or "".join(n + u for n, u in parts) != s:
        raise ValueError(text)
    return sum(float(n) * BENCH_UNITS[u] for n, u in parts)


def human_duration(sec):
    """5400 → '1시간 30분', 30 → '30초'."""
    sec = int(round(sec))
    h, rem = divmod(sec, 3600)
    m, s = divmod(rem, 60)
    out = [f"{h}시간"] * bool(h) + [f"{m}분"] * bool(m) + [f"{s}초"] * bool(s)
    return " ".join(out) or "0초"


def _mmss(sec):
    sec = int(sec)
    h, rem = divmod(sec, 3600)
    return f"{h}:{rem // 60:02d}:{rem % 60:02d}" if h else f"{sec // 60}:{sec % 60:02d}"


def _progress(msg, final=False):
    """터미널이면 한 줄을 덮어쓰며 갱신, 아니면 줄마다."""
    if sys.stdout.isatty():
        print("\r\033[K" + msg, end="\n" if final else "", flush=True)
    else:
        print(msg, flush=True)


class BenchSession(threading.Thread):
    """시나리오가 끝나고 앱을 켜 둔 동안: 1초마다 CPU·메모리 기록 + sample로 함수별 CPU 기록."""

    def __init__(self, ws, udid, seconds, base, profile=True):
        super().__init__(daemon=True)
        self.ws, self.udid, self.seconds, self.base, self.profile = ws, udid, seconds, base, profile
        self.stop = threading.Event()       # xcodebuild가 끝나면 (실패 등) 기다리지 않는다
        self.summary = None

    def run(self):
        ready, done = Path(f"{self.base}.ready"), Path(f"{self.base}.done")
        while not ready.exists():
            if self.stop.wait(1):
                return
        try:
            self.summary = self.measure()
        finally:
            done.write_text("done")

    def measure(self):
        ws, seconds = self.ws, self.seconds
        pid = sim_app_pid(self.udid, ws.bundle_id)
        if not pid:
            return {"error": "실행 중인 앱의 PID를 찾지 못함"}
        info(f"📈 성능 측정 시작: {ws.bundle_id} (PID {pid}), {human_duration(seconds)} — Mac 절전 방지 중")
        caffeinate = subprocess.Popen(["caffeinate", "-dimsu", "-t", str(int(seconds) + 120)])
        samples, sampler = [], None
        if self.profile:
            windows = sample_windows(seconds)
            t_start = time.monotonic()

            def take_samples():
                for idx, (t, dur) in enumerate(windows):
                    if self.stop.wait(max(0, t_start + t - time.monotonic())):
                        return
                    out = Path(f"{self.base}-sample.txt" if len(windows) == 1 else f"{self.base}-sample-{idx + 1:02d}.txt")
                    subprocess.run(["sample", str(pid), str(dur), str(SAMPLE_INTERVAL_MS), "-mayDie", "-file", str(out)],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    if out.exists():
                        samples.append(out)
            sampler = threading.Thread(target=take_samples, daemon=True)
            sampler.start()
        # 1초마다 CPU 사용률(누적 CPU 시간의 증가량 / 경과 시간)과 메모리
        rows = []
        start = time.monotonic()
        prev_cpu, prev_t = _cpu_seconds(pid)[0], start
        every = 1 if sys.stdout.isatty() else (10 if seconds <= 120 else 60)   # 진행 표시 간격(초)
        while time.monotonic() - start < seconds:
            time.sleep(1)
            cpu, rss = _cpu_seconds(pid)
            now = time.monotonic()
            if cpu is None:
                rows.append((now - start, None, None))
                break   # 앱 종료
            pct = (cpu - prev_cpu) / (now - prev_t) * 100 if prev_cpu is not None else 0.0
            rows.append((now - start, pct, rss))
            prev_cpu, prev_t = cpu, now
            if len(rows) % every == 0:
                valid = [c for _, c, _ in rows if c is not None]
                _progress(f"📈 성능 측정 중 {_mmss(now - start)} / {_mmss(seconds)} · CPU 지금 {pct:.0f}% · "
                          f"평균 {sum(valid) / len(valid):.0f}% · 메모리 {rss:.0f}MB")
        _progress(f"📈 성능 측정 완료 {_mmss(time.monotonic() - start)} / {_mmss(seconds)}", final=True)
        csv = Path(f"{self.base}-cpu.csv")
        csv.write_text("seconds,cpu_percent,memory_mb\n" + "".join(
            f"{s:.0f},{'' if c is None else f'{c:.1f}'},{'' if m is None else f'{m:.1f}'}\n" for s, c, m in rows))
        result = {"pid": pid, "csv": str(csv), "samples": len(rows)}
        if not self.profile:
            result["profile_skipped"] = "--no-profile로 실행함"
        cpus = sorted(c for _, c, _ in rows if c is not None)
        mems = [m for _, _, m in rows if m is not None]
        if cpus:
            result.update(cpu_avg=sum(cpus) / len(cpus), cpu_max=cpus[-1],
                          cpu_p95=cpus[min(len(cpus) - 1, int(len(cpus) * 0.95))])
        if mems:
            result.update(mem_start=mems[0], mem_end=mems[-1], mem_max=max(mems))
        if rows and rows[-1][1] is None:
            result["error"] = f"측정 중 앱이 종료됨 ({rows[-1][0]:.0f}초)"
        # sample은 찍은 뒤 함수 이름을 붙이는(심볼 정리) 데 시간이 조금 더 걸린다
        if sampler:
            t0 = time.monotonic()
            while sampler.is_alive() and time.monotonic() - t0 < 300:
                _progress(f"🔎 함수별 CPU 기록 정리 중 {_mmss(time.monotonic() - t0)}")
                sampler.join(1 if sys.stdout.isatty() else 15)
            _progress(f"🔎 함수별 CPU 기록 정리 끝 ({_mmss(time.monotonic() - t0)})", final=True)
            result["samples_files"] = [str(f) for f in samples]
            result["sample_windows"] = sample_windows(seconds)
            result["sample_top"] = sample_top(samples) if samples else None
        caffeinate.terminate()
        return result


def atos_names(dsym, load_addr, addresses):
    """앱 주소 → 함수 이름 (dSYM + atos). 기기 전체 녹화는 앱 함수 이름이 안 붙어 직접 붙인다."""
    dwarf = next((Path(dsym) / "Contents" / "Resources" / "DWARF").glob("*"), None) if dsym else None
    if not dwarf or not load_addr or not addresses:
        return {}
    addrs, names = sorted(addresses), {}
    for i in range(0, len(addrs), 500):
        chunk = addrs[i:i + 500]
        r = run(["xcrun", "atos", "-o", str(dwarf), "-arch", "arm64", "-l", load_addr, *chunk], check=False)
        for a, line in zip(chunk, (r.stdout or "").splitlines()):
            name = re.sub(r" \(in [^)]*\)( \([^)]*\))?$", "", line.strip())
            if name and not name.startswith("0x"):
                names[a] = name
    return names


def time_profile_analyze(trace, app_binary, seconds, limit=10, pid=None, dsym=None):
    """Time Profiler 기록(.trace) → 1초 단위 CPU %, 직접 CPU를 쓴 함수, 앱 코드 기준(부른 것 포함) 상위 목록.
    xctrace export의 XML은 같은 값을 id로 한 번 쓰고 다음부터 ref로 가리킨다 → 값을 캐시하며 한 줄씩 읽는다."""
    xml = Path(f"{trace}.xml")
    with open(xml, "w") as f:
        r = subprocess.run(["xcrun", "xctrace", "export", "--input", str(trace), "--xpath",
                            '/trace-toc/run[@number="1"]/data/table[@schema="time-profile"]'],
                           stdout=f, stderr=subprocess.DEVNULL)
    if r.returncode != 0:
        xml.unlink(missing_ok=True)
        return None
    cache = {}

    def val(el, conv=lambda e: e.text):
        if el is None:
            return None
        if el.get("ref"):
            return cache.get(el.get("ref"))
        v = conv(el)
        if el.get("id"):
            cache[el.get("id")] = v
        return v

    loads = {}

    def binary(e):
        if e.get("name") and e.get("load-addr"):
            loads.setdefault(e.get("name"), e.get("load-addr"))
        return e.get("name") or ""

    def frame(el):
        b = el.find("binary")
        return (el.get("name") or "?", val(b, binary) or "")

    def backtrace(el):
        inner = el.find("backtrace") if el.tag == "tagged-backtrace" else el
        if inner is not el and inner is not None:
            return val(inner, lambda e: [val(fr, frame) for fr in e.findall("frame")])
        return [val(fr, frame) for fr in el.findall("frame")]

    per_sec, selfc, appc, total, t0 = {}, {}, {}, 0, None
    try:
        for _, el in ET.iterparse(str(xml), events=("end",)):
            if el.tag != "row":
                continue
            t = val(el.find("sample-time"), lambda e: int(e.text or 0))
            w = val(el.find("weight"), lambda e: int(e.text or 0)) or 1_000_000
            bt_el = el.find("tagged-backtrace")
            bt_el = bt_el if bt_el is not None else el.find("backtrace")
            stack = val(bt_el, backtrace) if bt_el is not None else None
            proc = val(el.find("process"), lambda e: e.get("fmt") or "")
            el.clear()
            if t is None:
                continue
            if pid and proc and not proc.endswith(f"({pid})"):
                continue   # 기기 전체 녹화: 대상 앱 샘플만
            t0 = t if t0 is None else t0
            sec = int((t - t0) / 1e9)
            per_sec[sec] = per_sec.get(sec, 0) + w
            if not stack:
                continue
            total += 1
            fn, lib = stack[0]
            key = (fn if fn != "???" else f"??? ({lib})", lib)
            selfc[key] = selfc.get(key, 0) + 1
            seen = set()
            for name, b in stack:
                if b == app_binary and name not in seen and name not in SAMPLE_APP_SKIP \
                        and not name.startswith(SAMPLE_APP_SKIP_PREFIX):
                    seen.add(name)
                    appc[name] = appc.get(name, 0) + 1
    except ET.ParseError:
        pass
    finally:
        xml.unlink(missing_ok=True)
    if not total:
        return None
    # 앱 함수가 주소(0x…)로만 남았으면 dSYM으로 이름을 붙인다 (같은 함수의 여러 주소는 하나로 합친다)
    unresolved = {fn for fn, b in selfc if b == app_binary and fn.startswith("0x")} | {fn for fn in appc if fn.startswith("0x")}
    names = atos_names(dsym, loads.get(app_binary), unresolved)
    if names:
        merged_self, merged_app = {}, {}
        for (fn, lb), v in selfc.items():
            key = (names.get(fn, fn), lb)
            merged_self[key] = merged_self.get(key, 0) + v
        for fn, v in appc.items():
            merged_app[names.get(fn, fn)] = max(merged_app.get(names.get(fn, fn), 0), v)
        selfc, appc = merged_self, {fn: v for fn, v in merged_app.items()
                                     if fn not in SAMPLE_APP_SKIP and not fn.startswith(SAMPLE_APP_SKIP_PREFIX)}
    pct = lambda v: v * 100.0 / total
    cpu = [per_sec.get(i, 0) / 1e7 for i in range(min(int(seconds), (max(per_sec) + 1) if per_sec else 0))]
    return {
        "cpu": cpu, "active": total, "symbolicated": bool(names) or not unresolved,
        "self": [(fn, "앱" if lb == app_binary else lb, pct(v)) for (fn, lb), v in
                 sorted(selfc.items(), key=lambda x: -x[1])[:limit]],
        "app": [(fn, "", pct(v)) for fn, v in sorted(appc.items(), key=lambda x: -x[1])[:limit]],
    }


class DeviceBenchSession(threading.Thread):
    """실기기: 실행기가 '[qakit-bench] ready'를 출력하면 앱에 Time Profiler를 붙여 그 시간 동안 녹화하고 분석한다.
    (실기기 앱은 Mac 프로세스가 아니라 ps·sample을 쓸 수 없다. CPU %도 Time Profiler 샘플로 계산한다)"""

    def __init__(self, ws, seconds, base, app_binary):
        super().__init__(daemon=True)
        self.ws, self.seconds, self.base, self.app_binary = ws, seconds, base, app_binary
        self.ready = threading.Event()
        self.stop = threading.Event()
        self.summary = None

    def on_line(self, line):
        if "[qakit-bench] ready" in line:
            self.ready.set()

    def run(self):
        while not self.ready.wait(1):
            if self.stop.is_set():
                return
        self.summary = self.measure()

    def measure(self):
        ws, seconds = self.ws, self.seconds
        pid = None
        for _ in range(10):
            pid = device_app_pid(ws)
            if pid:
                break
            time.sleep(1)
        if not pid:
            return {"error": "기기에서 실행 중인 앱을 찾지 못함"}
        info(f"📈 성능 측정 시작: {ws.device['name']} · {ws.bundle_id} (PID {pid}), {human_duration(seconds)} — Time Profiler")
        trace = Path(f"{self.base}.trace")
        log = Path(f"{self.base}-xctrace.log")

        def record(target):
            shutil.rmtree(trace, ignore_errors=True)
            return subprocess.Popen(["xcrun", "xctrace", "record", "--template", "Time Profiler",
                                     "--device", ws.device["udid"], *target,
                                     "--time-limit", f"{int(seconds)}s", "--output", str(trace), "--no-prompt"],
                                    stdout=open(log, "w"), stderr=subprocess.STDOUT)
        # 앱 하나에만 붙인다 (기록이 작다). 무선 연결에서는 앱을 못 찾는 경우가 있어 → 기기 전체를 녹화하고 앱 샘플만 고른다
        self.whole_device = False
        xt = record(["--attach", str(pid)])
        start, began, every = time.monotonic(), None, 1 if sys.stdout.isatty() else 15
        while xt.poll() is None or (not self.whole_device and "Cannot find process" in
                                    (log.read_text(errors="replace") if log.exists() else "")):
            text = log.read_text(errors="replace") if log.exists() else ""
            if not self.whole_device and "Cannot find process" in text:
                xt.wait()
                info("ℹ️  무선 연결이라 앱에만 붙지 못함 → 기기 전체를 녹화하고 앱 샘플만 골라냅니다 (기록이 1분에 200MB 안팎)")
                self.whole_device = True
                xt = record(["--all-processes"])
                time.sleep(1)
                continue
            now = time.monotonic()
            if began is None and "Ctrl-C to stop the recording" in text:
                began = now
            if began is None and now - start > 90:
                xt.send_signal(2)
                break
            if began is not None and "Recording completed" not in text:
                _progress(f"📈 성능 측정 중 {_mmss(min(now - began, seconds))} / {_mmss(seconds)} (Time Profiler 녹화)")
            elif "Recording completed" in text:
                _progress(f"🧹 측정 완료 → Time Profiler 저장 중 {_mmss(now - began - seconds)}")
            if now - start > seconds + 600:
                xt.send_signal(2)
                break
            time.sleep(every)
        try:
            xt.wait(timeout=120)
        except subprocess.TimeoutExpired:
            xt.kill()
            xt.wait()
        _progress("📈 성능 측정 끝", final=True)
        text = log.read_text(errors="replace") if log.exists() else ""
        result = {"pid": pid, "device": ws.device["name"]}
        if xt.returncode != 0 or not trace.exists() or began is None:
            shutil.rmtree(trace, ignore_errors=True)
            result["trace_error"] = (text.strip().splitlines() or ["(출력 없음)"])[-1]
            return result
        log.unlink(missing_ok=True)
        result["trace"] = str(trace)
        info("🔎 Time Profiler 기록에서 CPU 사용률·함수 정리 중…")
        app_path = find_built_app(ws)
        dsym = app_path.with_name(app_path.name + ".dSYM") if app_path else None
        top = time_profile_analyze(trace, self.app_binary, seconds, pid=pid if self.whole_device else None,
                                   dsym=dsym if dsym and dsym.exists() else None)
        # 녹화가 중간에 끊겼는지 (예: 무선 연결이 끊김)
        toc = run(["xcrun", "xctrace", "export", "--input", str(trace), "--toc"], check=False).stdout or ""
        dur = re.search(r"<duration>([\d.]+)</duration>", toc)
        why = re.search(r"<end-reason>([^<]+)</end-reason>", toc)
        if dur and float(dur.group(1)) < seconds * 0.9:
            result["error"] = (f"녹화가 {float(dur.group(1)):.0f}초 만에 끝남 ({why.group(1) if why else '이유 모름'})"
                               + (" — 무선 연결은 테스트와 녹화를 같이 하면 끊길 수 있음 → 케이블로 연결해 다시"
                                  if ws.device.get("transport") != "wired" else ""))
        if not top:
            result["error"] = "Time Profiler 기록에 앱 샘플이 없음"
            return result
        cpus = top["cpu"]
        csv = Path(f"{self.base}-cpu.csv")
        csv.write_text("seconds,cpu_percent\n" + "".join(f"{i + 1},{c:.1f}\n" for i, c in enumerate(cpus)))
        s = sorted(cpus)
        result.update(csv=str(csv), samples=len(cpus), cpu_avg=sum(cpus) / len(cpus), cpu_max=s[-1],
                      cpu_p95=s[min(len(s) - 1, int(len(s) * 0.95))],
                      top=top, top_raw=str(trace),
                      top_how="Time Profiler, 1ms 간격, 측정 전체" + (" · 무선이라 기기 전체 녹화에서 앱만 골라냄" if self.whole_device else ""))
        return result


def write_bench_summary(base, seconds, scenario, ws, s):
    where = f"실기기 {ws.device['name']} ({ws.device['model']}, iOS {ws.device['os']})" if ws.device else f"시뮬레이터 {ws.simulator}"
    lines = [f"# 성능 측정 요약", f"시나리오: {scenario}", f"앱: {ws.bundle_id} ({ws.configuration}, {ws.build}) · {where}",
             f"측정: {human_duration(seconds)} (시나리오 마지막 화면에서 그대로)", ""]
    if s.get("error"):
        lines.append(f"⚠️ {s['error']}")
    if "cpu_avg" in s:
        lines += [f"CPU 평균 {s['cpu_avg']:.1f}%  ·  p95 {s['cpu_p95']:.1f}%  ·  최대 {s['cpu_max']:.1f}%  "
                  f"(100% = 코어 1개, 샘플 {s['samples']}개)",
                  *([f"메모리 시작 {s['mem_start']:.0f}MB → 끝 {s['mem_end']:.0f}MB (최대 {s['mem_max']:.0f}MB)"]
                    if "mem_start" in s else []),
                  f"1초 단위 기록: {s['csv']}"]
    top, wins = s.get("sample_top"), s.get("sample_windows") or []
    if s.get("top"):
        top = s["top"]
        lines += ["", f"함수별 CPU ({s['top_how']}) — 샘플 {top['active']:,}개 기준", "직접 CPU를 쓴 함수 (스택 맨 위):"]
        short = lambda t: t if len(t) <= 90 else t[:87] + "…"
        lines += [f"  {pct:5.1f}%  {short(fn)}  [{lb}]" for fn, lb, pct in top["self"]]
        if top["app"]:
            lines.append("앱 코드 기준 (그 함수가 부른 것까지 포함):")
            lines += [f"  {pct:5.1f}%  {short(fn)}" for fn, _, pct in top["app"]]
        lines.append(f"Time Profiler 기록: {s['top_raw']} (Instruments로 열기: open <파일>)")
    elif s.get("trace_error"):
        lines += ["", f"Time Profiler 녹화 실패: {s['trace_error']}"]
    elif top:
        covered = sum(d for _, d in wins)
        how = "측정 전체" if len(wins) == 1 else f"{_mmss(SAMPLE_EVERY)}마다 {SAMPLE_WINDOW}초씩 {len(wins)}번, 합계 {human_duration(covered)}"
        lines += ["", f"함수별 CPU (sample, {SAMPLE_INTERVAL_MS}ms 간격, {how}) — 기다리는 스레드는 빼고 CPU를 쓴 샘플 {top['active']:,}개 기준",
                  "직접 CPU를 쓴 함수 (스택 맨 위):"]
        short = lambda t: t if len(t) <= 90 else t[:87] + "…"
        lines += [f"  {pct:5.1f}%  {short(fn)}  [{lb}]" for fn, lb, pct in top["self"]]
        if top["app"]:
            lines.append("앱 코드 기준 (그 함수가 부른 것까지 포함):")
            lines += [f"  {pct:5.1f}%  {short(fn)}" + (f"  — {src}" if src else "") for fn, src, pct in top["app"]]
        files = s.get("samples_files") or []
        lines.append(f"원본 호출 트리: {files[0] if len(files) == 1 else Path(files[0]).parent / 'bench-sample-*.txt'}")
    elif s.get("profile_skipped"):
        lines += ["", "함수별 CPU: 건너뜀 (" + s["profile_skipped"] + ")"]
    elif "sample_top" in s:
        lines += ["", "함수별 CPU: sample 기록을 얻지 못함"]
    lines.append("")
    lines.append("주의: 실기기 측정. Time Profiler를 붙인 동안이라 약간의 부하가 더해진다." if ws.device else
                 "주의: 시뮬레이터(Mac CPU) 측정이라 실제 기기와 절대값이 다르다. 같은 조건끼리 비교할 때 쓴다.")
    path = Path(f"{base}-summary.txt")
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    return path, lines


def _cmd_run(ws, args):
    path, scenario = load_checked_scenario(ws, args.scenario, strict=not args.no_check)
    overrides = {}
    for item in args.var or []:
        key, sep, value = item.partition("=")
        if not sep or not key.strip():
            fail(f"--var 형식이 잘못됐습니다: {item!r}", '예) --var ship="ULTRA FOREST"')
        overrides[key.strip()] = value
    if overrides:
        scenario["vars"] = dict(scenario.get("vars") or {}, **overrides)
        info("변수: " + ", ".join(f"{k}={v}" for k, v in overrides.items()))
    out = ws.root / ".qakit" / "scenarios" / (path.name.replace(".qa.yml", "") + ".json")
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(scenario_tools.to_json(scenario), encoding="utf-8")
    auto_sync(ws)
    extra = {"SCENARIO_JSON": str(out)}
    if args.reset or scenario.get("reset") is True:
        reset_app(ws, ensure_booted(ws))
        extra["RESET"] = "1"
    bench = None
    run_dir = None
    if args.bench:
        try:
            bench_seconds = int(round(parse_duration(args.bench)))
        except ValueError:
            fail(f"--bench {args.bench}: 시간에 단위를 붙이세요.",
                 "예) --bench 30s (30초) / --bench 30m (30분) / --bench 1h (1시간) / --bench 1h30m · 30초 · 5분도 됨")
        if bench_seconds < BENCH_MIN_SECONDS:
            fail(f"--bench는 {BENCH_MIN_SECONDS}초 이상이어야 합니다 (입력: {human_duration(bench_seconds)}).")
        run_dir = new_run_dir(ws, "run", path.name.replace(".qa.yml", ""))
        base = run_dir / "bench"
        extra["BENCH_SIGNAL"] = str(base)
        extra["BENCH_SECONDS"] = str(bench_seconds)
        profile = not args.no_profile
        if ws.device:
            # 실기기: CPU %와 함수 목록을 모두 Time Profiler로 잰다 (ps·sample은 Mac 프로세스에만 됨)
            if args.no_profile:
                warn("실기기는 Time Profiler로만 잴 수 있어 --no-profile을 무시합니다")
            profile = True
            extra["BENCH_SIGNAL"] = "device"
            extra["BENCH_LEAD"] = "45"   # Time Profiler가 붙는 데 걸리는 시간만큼 더 둔다
            app_path = find_built_app(ws)
            binary = "app"
            if app_path:
                with open(app_path / "Info.plist", "rb") as f:
                    binary = plistlib.load(f).get("CFBundleExecutable", binary)
            bench = DeviceBenchSession(ws, bench_seconds, base, binary)
        else:
            bench = BenchSession(ws, ensure_booted(ws), bench_seconds, base, profile=profile)
        bench.start()
        info(f"성능 측정 예약: 시나리오가 끝나면 {human_duration(bench_seconds)} 동안 "
             + ("CPU + 함수별 CPU (Time Profiler)" if ws.device else
                "CPU·메모리" + (" + 함수별 CPU(sample)" if profile else "")) + " 기록")
    info(f"시나리오 실행: {scenario.get('name')} ({path.name})")
    try:
        success, xcresult, _ = run_scenario_runner(ws, "test_run", extra, label="run",
                                                   on_line=bench.on_line if isinstance(bench, DeviceBenchSession) else None,
                                                   history_name=path.name.replace(".qa.yml", ""), run_dir=run_dir)
    finally:
        if bench:
            bench.stop.set()
    if bench:
        # 실기기는 실행기가 끝난 뒤에도 Time Profiler 저장·분석이 남아 있을 수 있다
        bench.join(timeout=bench_seconds + 900 if ws.device else 300)
        for suffix in (".ready", ".done"):   # 실행기와 주고받은 신호 파일
            Path(f"{base}{suffix}").unlink(missing_ok=True)
        if bench.summary:
            summary_path, lines = write_bench_summary(base, bench_seconds, scenario.get("name"), ws, bench.summary)
            print()
            for line in lines[4:-1]:
                if line:
                    print("  " + line)
            ok(f"성능 측정 요약: {summary_path}")
        elif success:
            warn("성능 측정이 시작되지 않았습니다 (시나리오가 측정 단계까지 가지 못함)")
    print()
    if success:
        ok(f"통과 — 결과: {xcresult}")
        return
    print(summarize(xcresult, masker(ws.secrets())))
    fail("실패", f"자세한 결과: {xcresult}")


# ─────────────────────────────── 저장 · 복구 · 기록 ───────────────────────────────

def user_files(root):
    for entry in USER_FILES:
        p = root / entry
        if p.is_file():
            yield p
        elif p.is_dir():
            for f in sorted(p.rglob("*")):
                if f.is_file() and f.name != ".DS_Store":
                    yield f


def file_hash(path):
    return hashlib.sha1(path.read_bytes()).hexdigest()[:12]


def cmd_save(args):
    """결과물(시나리오·Swift·노트·설정)의 목록과 해시를 qa.lock.json에 남기고 보관소에 복사한다."""
    ws = find_workspace(args.workspace)
    update_readme(ws, quiet=False)
    files = {str(f.relative_to(ws.root)): file_hash(f) for f in user_files(ws.root)}
    state = app_state(ws)
    lock = {
        "name": ws.name,
        "savedAt": datetime.datetime.now().isoformat(timespec="seconds"),
        "message": args.message or "",
        "kit": kit_version(),
        "app": {k: state.get(k) for k in ("branch", "commit") if k in state},
        "files": files,
    }
    (ws.root / "qa.lock.json").write_text(json.dumps(lock, ensure_ascii=False, indent=2), encoding="utf-8")
    dest_root = ARCHIVE_DIR / ws.name
    snap = dest_root / lock["savedAt"].replace(":", "")
    for target in (snap, dest_root / "latest"):
        if target.exists():
            shutil.rmtree(target)
        for rel in list(files) + ["qa.lock.json"]:
            (target / rel).parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(ws.root / rel, target / rel)
    snaps = sorted(p for p in dest_root.iterdir() if p.is_dir() and p.name != "latest")
    for old in snaps[:-20]:
        shutil.rmtree(old)
    ok(f"저장: 파일 {len(files)}개 → qa.lock.json, 보관소 {dest_root}/latest")
    tracked = git(ws.root, "ls-files", "--error-unmatch", "qa.lock.json")
    if tracked is not None:
        info("ℹ️  이 폴더는 git으로 관리 중입니다. 커밋은 평소처럼: git add QA && git commit")


def cmd_restore(args):
    """AI 없이 복구: (보관소에서 파일 복사) → 생성물 다시 만들기 → 해시 확인 → 앱 설치 확인."""
    if args.from_name:
        src = ARCHIVE_DIR / args.from_name / "latest"
        if not src.exists():
            names = ", ".join(p.name for p in ARCHIVE_DIR.iterdir()) if ARCHIVE_DIR.exists() else "(없음)"
            fail(f"보관소에 '{args.from_name}'이(가) 없습니다.", f"보관소 목록: {names}")
        dest = Path(args.to).expanduser().resolve() if args.to else Path.cwd() / "QA"
        if (dest / "qakit.yml").exists() and not args.force:
            fail(f"이미 작업공간이 있습니다: {dest}", "덮어쓰려면 --force")
        for f in src.rglob("*"):
            if f.is_file():
                (dest / f.relative_to(src)).parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(f, dest / f.relative_to(src))
        ok(f"보관소 → {dest}")
        args.workspace = str(dest)
    ws = find_workspace(args.workspace)
    lock_path = ws.root / "qa.lock.json"
    if lock_path.exists():
        lock = json.loads(lock_path.read_text())
        missing, changed = [], []
        for rel, h in lock.get("files", {}).items():
            f = ws.root / rel
            if not f.exists():
                missing.append(rel)
            elif file_hash(f) != h:
                changed.append(rel)
        if missing:
            warn(f"저장 기록에 있는데 없는 파일 {len(missing)}개: " + ", ".join(missing[:10]))
        if changed:
            info(f"ℹ️  저장 이후 바뀐 파일 {len(changed)}개: " + ", ".join(changed[:10]))
        if not missing:
            ok(f"결과물 {len(lock.get('files', {}))}개 확인 (저장: {lock.get('savedAt')}, 앱 {lock.get('app', {}).get('branch')}@{lock.get('app', {}).get('commit')})")
    else:
        warn("qa.lock.json이 없습니다 (qakit save로 만든 적 없음). 있는 파일로 복구합니다.")
    if has_swift_runner(ws):
        refresh_runner_template(ws)
    generate_ids(ws, quiet=False)
    udid = ensure_booted(ws)
    changed_app, why, _ = app_changed(ws)
    if changed_app or not app_installed(udid, ws.bundle_id):
        info(f"앱 빌드·설치: {why or '설치 안 됨'}")
        cmd_build_app_ws(ws)
    if not ws.secrets_path.exists() and (ws.root / "secrets.example.txt").exists():
        warn(f"secrets.txt가 없습니다 (보안상 저장·복구하지 않음). {ws.secrets_path}에 다시 넣으세요.")
    update_readme(ws)
    scen = sorted((ws.root / "scenarios").glob("*.qa.yml"))
    ok("복구 완료 — AI 없이 바로 실행할 수 있습니다:")
    for p in scen[:10]:
        info(f"   qakit run {p.name.replace('.qa.yml', '')}")
    if has_swift_runner(ws):
        info("   qakit test   (Swift 테스트)")


def cmd_history(args):
    ws = find_workspace(args.workspace)
    f = ws.root / "history.jsonl"
    if not f.exists():
        fail("실행 기록이 없습니다.", "qakit run / qakit test를 실행하면 쌓입니다.")
    rows = [json.loads(l) for l in f.read_text(encoding="utf-8").splitlines() if l.strip()]
    if args.test:
        rows = [r for r in rows if args.test in r.get("test", "")]
    for r in rows[-args.n:]:
        mark = {"Passed": "✅", "Failed": "❌", "Skipped": "⏭"}.get(r.get("result"), "•")
        app = r.get("app", {})
        print(f"{r.get('at','')}  {mark} {r.get('test',''):<45} {r.get('seconds',0):>6}s  "
              f"앱 {app.get('branch','-')}@{app.get('commit','-')}  [{r.get('kind')}]")


# ─────────────────────────────── 명령: install-skill ───────────────────────────────

def cmd_install_skill(args):
    """스킬을 Claude Code·Codex에, qakit을 PATH에 심볼릭 링크로 설치 (도구 레포 수정이 바로 반영됨)."""
    skill = KIT_DIR / "skills" / "ios-qa-kit"
    links = [
        (Path.home() / ".claude" / "skills" / "ios-qa-kit", skill, "Claude Code 스킬"),
        (Path.home() / ".agents" / "skills" / "ios-qa-kit", skill, "Codex 스킬"),
        (Path.home() / ".local" / "bin" / "qakit", KIT_DIR / "bin" / "qakit", "qakit 명령"),
    ]
    for link, target, label in links:
        if args.uninstall:
            if link.is_symlink():
                link.unlink()
                ok(f"제거: {label} ({link})")
            continue
        if link.is_symlink():
            if Path(os.path.realpath(link)) == target.resolve():
                ok(f"이미 설치됨: {label} → {link}")
                continue
            link.unlink()
        elif link.exists():
            warn(f"건너뜀: {link}가 이미 있습니다 (링크 아님). 직접 확인하세요.")
            continue
        link.parent.mkdir(parents=True, exist_ok=True)
        link.symlink_to(target)
        ok(f"설치: {label} → {link}")
    if not args.uninstall and str(Path.home() / ".local" / "bin") not in os.environ.get("PATH", ""):
        warn("~/.local/bin이 PATH에 없습니다. 셸 설정에 추가하세요: export PATH=\"$HOME/.local/bin:$PATH\"")


# ─────────────────────────────── 명령: update ───────────────────────────────

def cmd_update(args):
    """설치한 도구 폴더를 원격의 최신으로 받는다 (git fast-forward만). 명령·스킬은 링크라 그대로 바뀐다."""
    repo = KIT_DIR
    if git(repo, "rev-parse", "--git-dir") is None:
        fail(f"{repo}는 git 저장소가 아닙니다.", "git clone으로 설치한 경우만 qakit update를 쓸 수 있습니다")
    branch = git(repo, "rev-parse", "--abbrev-ref", "HEAD")
    upstream = git(repo, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
    if not upstream:
        fail(f"브랜치 {branch}에 연결된 원격 브랜치가 없습니다.", f"git -C {repo} branch -u origin/main")
    if branch != "main":
        warn(f"설치 폴더가 {branch} 브랜치입니다. 배포 버전은 main입니다 (개발 중이 아니면 git -C {repo} switch main)")

    old_version = kit_version()
    info(f"확인 중: {repo} ({branch}, {old_version})")
    r = run(["git", "-C", str(repo), "fetch", "--tags", "--quiet"], check=False)
    if r.returncode != 0:
        fail("원격 저장소에서 받지 못했습니다 (네트워크·권한 확인)", (r.stdout or "")[-400:])

    behind = int(git(repo, "rev-list", "--count", "HEAD..@{u}") or 0)
    ahead = int(git(repo, "rev-list", "--count", "@{u}..HEAD") or 0)
    if behind == 0:
        ok(f"이미 최신입니다: qakit {old_version} ({branch})")
        if ahead:
            info(f"   로컬에만 있는 커밋 {ahead}개가 있습니다")
        return
    new_version = (git(repo, "show", "@{u}:VERSION") or "?").strip()
    info(f"새 버전: {old_version} → {new_version} (커밋 {behind}개)")
    for line in (git(repo, "log", "--oneline", "--no-merges", "HEAD..@{u}") or "").splitlines()[:20]:
        print(f"   {line}")
    if args.check:
        info("받으려면: qakit update")
        return

    dirty = [l for l in (git(repo, "status", "--porcelain", "--untracked-files=no") or "").splitlines() if l.strip()]
    if dirty:
        fail("설치 폴더에 고친 파일이 있어 업데이트하지 않습니다: " + ", ".join(l[3:] for l in dirty[:5]),
             f"git -C {repo} status 로 확인 (버려도 되면 git -C {repo} checkout -- .)")
    if ahead:
        fail(f"설치 폴더에 원격에 없는 커밋이 {ahead}개 있어 빨리 감기(fast-forward)가 안 됩니다.",
             f"git -C {repo} log @{{u}}..HEAD 로 확인")
    r = run(["git", "-C", str(repo), "merge", "--ff-only", "--quiet", "@{u}"], check=False)
    if r.returncode != 0:
        fail("업데이트 실패", (r.stdout or "")[-400:])
    ok(f"업데이트 완료: qakit {kit_version()}")

    # 명령·스킬 링크가 이 폴더를 가리키는지 (다른 폴더를 가리키면 업데이트가 반영되지 않는다)
    links = [Path.home() / ".local" / "bin" / "qakit", Path.home() / ".claude" / "skills" / "ios-qa-kit",
             Path.home() / ".agents" / "skills" / "ios-qa-kit"]
    elsewhere = [str(l) for l in links if l.is_symlink() and not Path(os.path.realpath(l)).is_relative_to(repo.resolve())]
    if elsewhere:
        warn("다른 폴더를 가리키는 링크가 있습니다: " + ", ".join(elsewhere) + f" → {repo}/bin/qakit install-skill")
    info("AutoID·swiftui-ids 도구는 다음 build-app 때 바뀐 것만 자동으로 다시 빌드됩니다.")


# ─────────────────────────────── main ───────────────────────────────

def main():
    parser = argparse.ArgumentParser(prog="qakit", description="AI용 XCUITest 도구")
    version = (KIT_DIR / "VERSION").read_text().strip() if (KIT_DIR / "VERSION").exists() else "dev"
    branch = run(["git", "-C", str(KIT_DIR), "rev-parse", "--abbrev-ref", "HEAD"], check=False).stdout.strip()
    parser.add_argument("--version", action="version",
                        version=f"qakit {version}" + (f" ({branch})" if branch and branch != "HEAD" else ""))
    parser.add_argument("-w", "--workspace", help="작업공간 경로 (기본: 현재 폴더에서 qakit.yml 탐색)")
    parser.add_argument("--app", help="앱 경로 일시 지정 (다른 워크트리/브랜치 폴더 검증용)")
    parser.add_argument("--build", choices=["debug", "release"], default="debug",
                        help="빌드 종류 (기본 debug = qakit.yml app.configuration, release = app.release.configuration 기본 Release)")
    device_help = "실기기에서 실행: select(방향키로 고르기, 값 생략 시) · last(지난번 기기) · <기기 이름>"
    parser.add_argument("--device", nargs="?", const="select", default=None, metavar="기기", help=device_help)
    parser.add_argument("--secrets", help="비밀값 파일 직접 지정 (기본: qakit.yml의 secrets). 계정을 바꿔 돌릴 때")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("init", help="작업공간 생성")
    p.add_argument("project", help="앱 프로젝트 경로 (.xcodeproj/.xcworkspace 또는 그 폴더)")
    p.add_argument("--name", help="작업공간 이름 (기본: 프로젝트 폴더 이름)")
    p.add_argument("--dir", help="작업공간 경로 (기본: <프로젝트 상위>/qa-workspaces/<이름>)")
    p.add_argument("--scheme", help="scheme 직접 지정")
    p.add_argument("--simulator", help="시뮬레이터 이름")
    p.add_argument("--force", action="store_true", help="템플릿 파일 덮어쓰기 (Flows/ 테스트는 유지)")
    p.add_argument("--in-project", action="store_true", help="앱 프로젝트 안 QA/ 폴더에 만들기")
    p.add_argument("--git-exclude", action="store_true", help="QA/를 이 PC에서만 git 무시 (.git/info/exclude)")
    p.add_argument("--worktree", action="store_true",
                   help="QA 전용 워크트리(<레포>-qa, 브랜치 qa/workspace)를 만들고 그 안 QA/에 작업공간 생성 (권장)")
    p.add_argument("--worktree-dir", help="워크트리 위치 직접 지정")
    p.add_argument("--branch", help="워크트리 브랜치 (기본 qa/workspace)")
    p.add_argument("--base", help="새 브랜치를 딸 기준 (기본 develop, 없으면 HEAD)")
    p.set_defaults(func=cmd_init)

    p = sub.add_parser("install-skill", help="AI 스킬(Claude Code·Codex)과 qakit 명령 설치")
    p.add_argument("--uninstall", action="store_true", help="설치한 링크 제거")
    p.set_defaults(func=cmd_install_skill)

    p = sub.add_parser("update", help="도구를 최신 버전으로 받기 (설치 폴더 git fast-forward)")
    p.add_argument("--check", action="store_true", help="새 버전이 있는지만 확인")
    p.set_defaults(func=cmd_update)

    p = sub.add_parser("doctor", help="환경 점검")
    p.set_defaults(func=cmd_doctor)

    p = sub.add_parser("build-app", help="대상 앱 빌드 + 설치 + 권한 허용")
    p.set_defaults(func=cmd_build_app)

    p = sub.add_parser("swiftui-ids", help="SwiftUI ID 삽입 도구: 목록 보기 / 손으로 삽입 / 복원")
    g = p.add_mutually_exclusive_group(required=True)
    g.add_argument("--list", action="store_true", help="삽입될 ID 목록 (소스 수정 없음)")
    g.add_argument("--insert", action="store_true", help="워크트리 소스에 삽입한 채 둔다 (diff 확인용. 끝나면 --restore)")
    g.add_argument("--restore", action="store_true", help="삽입을 되돌린다")
    p.set_defaults(func=cmd_swiftui_ids)

    p = sub.add_parser("sync", help="앱 변경 반영: 재빌드·설치 + ID 재생성 + 테스트 코드 컴파일 확인")
    p.add_argument("--rebuild", action="store_true", help="변경이 없어도 앱 재빌드")
    p.add_argument("--skip-build", action="store_true", help="앱 빌드 생략 (ID 재생성·컴파일 확인만)")
    p.set_defaults(func=cmd_sync)

    p = sub.add_parser("worktree-update", help="QA 워크트리를 따라갈 브랜치(기본 develop)의 최신 커밋으로 (merge, push 안 함)")
    p.add_argument("--from", dest="base", help="따라갈 브랜치 (기본: qakit.yml worktree.base, 없으면 develop)")
    p.add_argument("--check", action="store_true", help="뒤처졌는지만 확인")
    p.set_defaults(func=cmd_worktree_update)

    p = sub.add_parser("gen-ids", help="앱 소스에서 ID 상수(QAIDs.swift) 생성")
    p.add_argument("--verify", action="store_true", help="저장된 화면 덤프와 비교")
    p.set_defaults(func=cmd_gen_ids)

    p = sub.add_parser("dump-ui", help="화면 구조를 텍스트로 저장")
    p.add_argument("--attach", action="store_true", help="앱을 새로 띄우지 않고 지금 화면을 덤프")
    p.add_argument("--settle", type=float, default=3, help="덤프 전 대기 초 (기본 3)")
    p.add_argument("--wait-id", help="이 ID가 나타날 때까지 기다린 뒤 덤프")
    p.add_argument("--print", action="store_true", help="덤프 내용을 바로 출력")
    p.set_defaults(func=cmd_dump_ui)

    p = sub.add_parser("test", help="UI 테스트 실행")
    p.add_argument("filters", nargs="*", help="예) LoginFlowTests 또는 LoginFlowTests/test_ensureLoggedIn")
    p.add_argument("--reset", action="store_true", help="실행 전 앱 재설치 + 키체인 초기화 (로그아웃 상태)")
    p.set_defaults(func=cmd_test)

    p = sub.add_parser("run", help="시나리오 파일(.qa.yml) 실행 — Swift 테스트 없이")
    p.add_argument("scenario", help="scenarios/<이름>.qa.yml의 이름 또는 파일 경로")
    p.add_argument("--reset", action="store_true", help="실행 전 앱 재설치 + 키체인 초기화")
    p.add_argument("--no-check", action="store_true", help="ID 정적 검사 실패해도 실행")
    p.add_argument("--bench", metavar="시간",
                   help="시나리오가 끝난 화면 그대로 이 시간 동안 CPU·메모리 + 함수별 CPU(sample) 기록. "
                        "단위 필수: 30s·5m·1h·1h30m (30초·5분·1시간도 됨)")
    p.add_argument("--no-profile", action="store_true", help="--bench에서 함수별 CPU(sample) 없이 CPU·메모리만 기록")
    p.add_argument("--var", action="append", metavar="KEY=VALUE",
                   help='시나리오 변수 지정 (vars 기본값을 덮어씀, 여러 번 가능). 예) --var ship="ULTRA FOREST"')
    p.set_defaults(func=cmd_run)

    p = sub.add_parser("check", help="시나리오 형식·ID 정적 검사 (실행 없이)")
    p.add_argument("scenarios", nargs="*")
    p.set_defaults(func=cmd_check)

    p = sub.add_parser("save", help="결과물 목록·해시 기록(qa.lock.json) + 보관소 복사")
    p.add_argument("-m", "--message", help="저장 메모")
    p.set_defaults(func=cmd_save)

    p = sub.add_parser("restore", help="AI 없이 복구 (생성물 재생성·앱 설치·해시 확인)")
    p.add_argument("--from", dest="from_name", help="보관소(~/.qakit/archive)의 작업공간 이름에서 복사")
    p.add_argument("--to", help="--from으로 복사할 위치 (기본: ./QA)")
    p.add_argument("--force", action="store_true")
    p.set_defaults(func=cmd_restore)

    p = sub.add_parser("readme", help="QA 폴더 README.md의 QA 목록을 지금 상태로 갱신")
    p.set_defaults(func=cmd_readme)

    p = sub.add_parser("history", help="실행 기록 보기")
    p.add_argument("-n", type=int, default=20)
    p.add_argument("--test", help="이름에 이 글자가 들어간 것만")
    p.set_defaults(func=cmd_history)

    p = sub.add_parser("summarize", help="실패 원인 요약")
    p.add_argument("xcresult", nargs="?", help="기본: results/latest.xcresult")
    p.set_defaults(func=cmd_summarize)

    # --build는 명령 앞뒤 어디에 써도 되게 (qakit run x --build release)
    for sp in sub.choices.values():
        sp.add_argument("--build", choices=["debug", "release"], default=argparse.SUPPRESS,
                        help="빌드 종류 (기본 debug)")
        sp.add_argument("--device", nargs="?", const="select", default=argparse.SUPPRESS, metavar="기기",
                        help=device_help)

    args = parser.parse_args()
    args.workspace = getattr(args, "workspace", None)
    global SECRETS_OVERRIDE, APP_OVERRIDE, BUILD_MODE, DEVICE_ARG
    BUILD_MODE = args.build
    DEVICE_ARG = args.device
    SECRETS_OVERRIDE = args.secrets
    APP_OVERRIDE = args.app
    args.func(args)


if __name__ == "__main__":
    main()
